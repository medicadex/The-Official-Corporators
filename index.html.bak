        <!-- =====================================================================
             PAYSTACK DEDICATED VIRTUAL ACCOUNT (INSTANT INWARD TRANSFER RECEPTACLE)
             ===================================================================== -->
        <div id="dva-container" class="relative overflow-hidden rounded-3xl bg-gradient-to-r from-wmcNavy-950 via-slate-900 to-indigo-950 text-white p-6 sm:p-7 shadow-xl border border-slate-700/50">
          <div class="absolute -right-10 -bottom-10 w-56 h-56 bg-emerald-500/10 rounded-full blur-3xl pointer-events-none"></div>
          <div class="absolute right-12 top-6 opacity-10 font-mono text-8xl font-black pointer-events-none select-none">₦</div>
          
          <div class="relative z-10 flex flex-col lg:flex-row lg:items-center justify-between gap-6">
            <div class="space-y-2 max-w-xl">
              <div class="flex flex-wrap items-center gap-2">
                <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-[11px] font-extrabold bg-emerald-500/20 text-emerald-300 border border-emerald-500/30">
                  <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
                  Paystack Dedicated Account (DVA)
                </span>
                <span class="text-xs text-slate-400 font-mono">⚡ Automated Inward Settlement</span>
              </div>
              <h2 class="text-xl sm:text-2xl font-black text-white tracking-tight">
                Your Direct Co-op Transfer NUBAN
              </h2>
              <p class="text-xs sm:text-sm text-slate-300 leading-relaxed">
                Transfer directly from any Nigerian commercial bank app (GTBank, Zenith, Access, Kuda, OPay, Palmpay, etc.) into this dedicated account. Your cooperative savings ledger is credited automatically in real-time.
              </p>
              <div class="pt-2 flex flex-wrap items-center gap-3">
                <button type="button" onclick="openPaystackOnlinePaymentModal()" class="px-4 py-2 rounded-xl bg-gradient-to-r from-emerald-500 to-teal-600 hover:from-emerald-400 hover:to-teal-500 text-wmcNavy-950 font-black text-xs shadow-md transition flex items-center gap-2 active:scale-95">
                  <span>💳</span>
