                    <span class="font-bold text-amber-600">Up to ₦1,500,000</span>
                  </div>
                </div>
              </div>

              <button onclick="selectTierAndRegister('PLUS')" class="w-full py-3 rounded-xl btn-accent font-bold text-xs shadow-md">
                Select Gold Tier &rarr;
              </button>
            </div>

            <!-- TIER 3: PURPLE (Premium) -->
            <div class="tier-card tier-purple glass-panel p-8 rounded-2xl flex flex-col justify-between">
              <div>
                <div class="flex justify-between items-center mb-4">
                  <span class="px-3 py-1 rounded-full text-xs font-bold bg-purple-100 text-purple-900">Purple Tier</span>
                  <span class="text-xs text-slate-500 font-medium">Premium</span>
                </div>
                <h3 class="text-3xl font-extrabold text-wmcNavy-950 mb-1">₦50,000+</h3>
                <span class="text-xs text-slate-500 block mb-6">per calendar month</span>
                
                <p class="text-xs text-slate-600 mb-6 leading-relaxed">
