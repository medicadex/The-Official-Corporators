        </div>
      </div>

      <!-- Right Panel: Sign In Form & Quick Role Switcher (7 Cols) -->
      <div class="md:col-span-7 p-6 sm:p-8 flex flex-col justify-between bg-white">
        
        <div>
          <div class="flex justify-between items-start mb-5">
            <div>
              <h3 class="text-xl font-bold text-wmcNavy-950">Cooperative Portal Sign In</h3>
              <p class="text-xs text-slate-500">Sign in with your Member Code, Email, or Phone</p>
            </div>
            <button onclick="closeLoginModal()" class="text-slate-400 hover:text-slate-700 text-lg font-bold">✕</button>
          </div>

          <!-- Live Dynamic Alert Box -->
          <div id="login-alert" class="hidden p-3 rounded-xl text-xs mb-4"></div>

          <form id="login-form" onsubmit="handleLoginSubmit(event)" class="space-y-4 text-xs">
            
            <div>
              <label class="block font-bold text-slate-700 mb-1">Account Identifier *</label>
              <input type="text" id="login-identifier" required placeholder="e.g. WMC-2026-001 or name@wealthbridge.ng" class="w-full p-2.5 rounded-lg border border-slate-300 font-mono focus:ring-2 focus:ring-amber-500 focus:outline-none">
              <span class="text-[10px] text-slate-400 mt-1 block">Accepts Member Code, Registered Email, or Phone Number</span>
            </div>

            <div>
              <div class="flex justify-between items-center mb-1">
                <label class="font-bold text-slate-700">Access Password *</label>
                <button type="button" onclick="togglePasswordVisibility('login-password')" class="text-[10px] text-amber-600 font-semibold hover:underline">
                  Show/Hide
                </button>
              </div>
              <input type="password" id="login-password" required value="Wealthbridge@2026" placeholder="Enter password" class="w-full p-2.5 rounded-lg border border-slate-300 focus:ring-2 focus:ring-amber-500 focus:outline-none">
              <span class="text-[10px] text-slate-400 mt-1 block">Default initial test password: <code class="text-slate-600 bg-slate-100 px-1 py-0.5 rounded">Wealthbridge@2026</code></span>
            </div>

            <div class="pt-2">
              <button type="submit" id="btn-login-submit" class="w-full py-3 rounded-xl btn-primary font-bold text-xs shadow-md">
                Sign In to Portal &rarr;
              </button>
            </div>

          </form>

          <!-- Quick Test Role Selector (Instant 1-Click Testing) -->
          <div class="mt-6 pt-5 border-t border-slate-200">
            <div class="flex items-center justify-between mb-2">
              <span class="text-[11px] font-bold text-slate-500 uppercase tracking-wider block">
