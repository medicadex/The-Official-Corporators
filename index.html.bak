            <div class="flex justify-between items-center mb-1 text-xs">
              <span class="font-bold text-slate-700 flex items-center gap-1">
                <span>🛡️ KYC Completion:</span>
              </span>
              <span id="cockpit-kyc-percent" class="font-black text-amber-600 text-sm">0%</span>
            </div>
            <div class="w-full bg-slate-200 h-2.5 rounded-full overflow-hidden">
              <div id="cockpit-kyc-bar" class="bg-gradient-to-r from-amber-500 to-emerald-500 h-full rounded-full transition-all duration-500" style="width: 0%"></div>
            </div>
            <div class="text-[10px] text-slate-400 mt-1 flex justify-between items-center">
              <span>Status: <strong id="cockpit-kyc-status" class="text-slate-600">Pending</strong></span>
              <span class="text-amber-600 font-bold hover:underline">Update KYC &rarr;</span>
            </div>
          </div>

