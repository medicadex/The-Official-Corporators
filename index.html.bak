          </button>
          <button type="submit" id="btn-save-config" class="px-5 py-2.5 rounded-xl bg-gradient-to-r from-wmcNavy-950 to-indigo-950 hover:from-wmcNavy-900 hover:to-indigo-900 text-amber-300 font-bold shadow-md transition flex items-center gap-2 active:scale-95">
            <span>💾</span>
            <span>Save Configuration</span>
          </button>
        </div>
      </form>
    </div>
