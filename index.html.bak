              </button>
              <button type="button" id="btn-download-report-pdf" onclick="downloadCurrentReportPDF()" class="px-3.5 py-2.5 rounded-xl bg-slate-900 hover:bg-slate-800 text-white text-xs font-bold transition flex items-center gap-1.5 shadow-sm active:scale-95" title="Download Official Vector PDF">
                <span>📥</span>
                <span>Download PDF</span>
              </button>
              <button type="button" id="btn-print-report" onclick="printCurrentReportStatement()" class="px-3.5 py-2.5 rounded-xl border border-slate-300 hover:bg-slate-100 text-slate-700 text-xs font-bold transition flex items-center gap-1.5 shadow-sm active:scale-95" title="Print Statement">
