      </nav>

      <!-- Action Buttons & Authenticated User Control -->
      <div id="nav-auth-container" class="flex items-center gap-3">
        <!-- Guest State (Shown when logged out) -->
        <div id="nav-guest-actions" class="flex items-center gap-2">
          <button onclick="openLoginModal()" class="px-4 py-2 text-xs font-bold text-slate-700 hover:text-wmcNavy-900 border border-slate-300 rounded-lg transition hover:bg-slate-100 flex items-center gap-1.5 shadow-sm">
            <span>🔐</span>
            <span>Sign In</span>
          </button>
