              <span class="text-[10px] text-amber-600 font-semibold">1-Click Test Access</span>
            </div>
            <div class="grid grid-cols-2 sm:grid-cols-3 gap-1.5 text-[10px]">
              <button type="button" onclick="quickLoginAs('admin', 'Pass123*')" class="col-span-2 sm:col-span-3 p-2 rounded-lg bg-slate-900 hover:bg-slate-800 border border-amber-500/50 text-amber-300 font-bold text-left transition flex items-center justify-between shadow-sm group">
                <span class="flex items-center gap-2">
                  <span class="text-base">💻</span>
                  <span>
                    Developer Admin (Universal Clearance)
                    <br><span class="font-normal text-[9px] text-slate-300">Username: <strong class="text-amber-200 font-mono">admin</strong> &bull; Password: <strong class="text-amber-200 font-mono">Pass123*</strong></span>
                  </span>
                </span>
                <span class="px-2 py-0.5 rounded bg-amber-400 text-slate-950 text-[9px] font-extrabold uppercase tracking-wider group-hover:bg-amber-300 transition">Super Admin</span>
              </button>
              <button type="button" onclick="quickLoginAs('WMC-2026-001')" class="p-1.5 rounded-lg bg-amber-50 hover:bg-amber-100 border border-amber-200 text-amber-900 font-bold text-left transition">
                👑 President<br><span class="font-normal text-[9px] text-amber-700">Qazeem Adebowale</span>
              </button>
              <button type="button" onclick="quickLoginAs('WMC-2026-002')" class="p-1.5 rounded-lg bg-blue-50 hover:bg-blue-100 border border-blue-200 text-blue-900 font-bold text-left transition">
                📝 Gen. Secretary<br><span class="font-normal text-[9px] text-blue-700">Olaleke Olaoye</span>
              </button>
              <button type="button" onclick="quickLoginAs('WMC-2026-004')" class="p-1.5 rounded-lg bg-emerald-50 hover:bg-emerald-100 border border-emerald-200 text-emerald-900 font-bold text-left transition">
                💰 Fin. Secretary<br><span class="font-normal text-[9px] text-emerald-700">Rukayat Yahaya</span>
              </button>
              <button type="button" onclick="quickLoginAs('WMC-2026-005')" class="p-1.5 rounded-lg bg-purple-50 hover:bg-purple-100 border border-purple-200 text-purple-900 font-bold text-left transition">
                🏦 Treasurer<br><span class="font-normal text-[9px] text-purple-700">Evelyn Omokosi</span>
              </button>
              <button type="button" onclick="quickLoginAs('WMC-2026-003')" class="p-1.5 rounded-lg bg-slate-100 hover:bg-slate-200 border border-slate-300 text-slate-800 font-bold text-left transition">
                ⚖️ Legal Lead<br><span class="font-normal text-[9px] text-slate-600">Sulaimon Olajide</span>
              </button>
              <button type="button" onclick="quickLoginAs('WMC-2026-007')" class="p-1.5 rounded-lg bg-slate-50 hover:bg-slate-100 border border-slate-200 text-slate-700 font-bold text-left transition">
