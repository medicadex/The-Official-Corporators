      <div id="portal-reports-section" class="hidden space-y-8">
        
        <!-- Header & Control Bar Card -->
        <div class="glass-panel p-6 sm:p-7 rounded-3xl border border-slate-200 shadow-sm space-y-6">
          <div class="flex flex-col lg:flex-row lg:items-center justify-between gap-4 pb-4 border-b border-slate-200">
