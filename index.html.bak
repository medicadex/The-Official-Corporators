  <!-- =========================================================================
       MODAL: COOPERATOR PROFILE & STATUTORY KYC VERIFICATION CENTER
       ========================================================================= -->
  <div id="modal-profile" class="fixed inset-0 z-50 bg-slate-950/60 backdrop-blur-sm hidden flex items-center justify-center p-4">
    <div class="glass-panel bg-white w-full max-w-3xl rounded-3xl p-6 sm:p-8 shadow-2xl border border-slate-200 max-h-[92vh] overflow-y-auto">
      
      <!-- Modal Header -->
      <div class="flex justify-between items-start mb-6">
        <div>
          <div class="flex items-center gap-2">
            <span class="text-xl">👤</span>
            <h3 class="text-xl font-bold text-wmcNavy-950">Cooperator Profile &amp; KYC Center</h3>
          </div>
          <p class="text-xs text-slate-500 mt-0.5">Statutory Identity, Settlement Banking, Next of Kin &amp; Contact Governance</p>
        </div>
        <button onclick="closeProfileModal()" class="text-slate-400 hover:text-slate-700 text-lg font-bold p-1">✕</button>
      </div>

      <!-- KYC Completion Scorecard & Progress Bar -->
      <div class="p-5 bg-gradient-to-br from-slate-950 to-wmcNavy-900 text-white rounded-2xl mb-6 shadow-inner space-y-3">
        <div class="flex justify-between items-center">
          <div>
            <span class="text-xs text-slate-300 font-semibold block uppercase tracking-wider">KYC Verification Score</span>
            <span class="text-[11px] text-amber-300">Determines borrowing qualification and governance voting privileges</span>
          </div>
          <span id="kyc-percent-badge" class="px-3.5 py-1 rounded-full text-xs font-black bg-amber-400 text-slate-950 shadow">
            0% COMPLETE
          </span>
        </div>

        <div class="w-full bg-slate-800 h-3 rounded-full overflow-hidden p-0.5 border border-slate-700">
          <div id="kyc-progress-fill" class="bg-gradient-to-r from-amber-400 via-amber-300 to-emerald-400 h-full rounded-full transition-all duration-700 shadow" style="width: 0%"></div>
        </div>

        <!-- 6 KYC Pillars Breakdown Indicators -->
        <div class="grid grid-cols-2 sm:grid-cols-3 gap-2 pt-2 text-[11px]">
          <div id="pillar-personal" class="p-2 rounded-lg bg-slate-900/80 border border-slate-800 flex items-center justify-between">
            <span class="text-slate-300">Personal Info (20%)</span>
            <span class="pillar-status font-bold text-slate-500">⚪ Pending</span>
          </div>
          <div id="pillar-nin" class="p-2 rounded-lg bg-slate-900/80 border border-slate-800 flex items-center justify-between">
            <span class="text-slate-300">NIN &amp; ID (20%)</span>
            <span class="pillar-status font-bold text-slate-500">⚪ Pending</span>
          </div>
          <div id="pillar-contact" class="p-2 rounded-lg bg-slate-900/80 border border-slate-800 flex items-center justify-between">
            <span class="text-slate-300">Contact Details (20%)</span>
            <span class="pillar-status font-bold text-slate-500">⚪ Pending</span>
          </div>
          <div id="pillar-photo" class="p-2 rounded-lg bg-slate-900/80 border border-slate-800 flex items-center justify-between">
            <span class="text-slate-300">Passport Photo (10%)</span>
            <span class="pillar-status font-bold text-slate-500">⚪ Pending</span>
          </div>
          <div id="pillar-bank" class="p-2 rounded-lg bg-slate-900/80 border border-slate-800 flex items-center justify-between">
            <span class="text-slate-300">Bank Account (15%)</span>
            <span class="pillar-status font-bold text-slate-500">⚪ Pending</span>
          </div>
          <div id="pillar-nok" class="p-2 rounded-lg bg-slate-900/80 border border-slate-800 flex items-center justify-between">
            <span class="text-slate-300">Next of Kin (15%)</span>
            <span class="pillar-status font-bold text-slate-500">⚪ Pending</span>
          </div>
        </div>
      </div>

      <!-- Statutory Governance Rule Notice Box -->
      <div class="p-4 rounded-xl bg-amber-50 border border-amber-200 text-amber-950 text-xs mb-6 space-y-1">
        <div class="flex items-center gap-1.5 font-bold text-amber-900">
          <span>⚖️</span>
          <span>Statutory Governance Invariant (Article 2 &amp; SOP Section 2):</span>
        </div>
        <p class="leading-relaxed">
          Modifications to <strong>Residential Address</strong>, <strong>Phone Number</strong>, and <strong>Official Email</strong> are insulated against immediate overwrite to prevent unauthorized account takeover. Any changes to these 3 fields are queued for dual statutory sign-off by the <strong>President</strong> and <strong>General Secretary</strong>. Personal info, NIN, Banking, Next of Kin, and Passport Photograph update immediately.
        </p>
      </div>

      <!-- Active Pending Approval Banner (Shown dynamically when a contact change is pending) -->
      <div id="modal-pending-contact-alert" class="hidden p-4 rounded-xl bg-blue-50 border border-blue-300 text-blue-950 text-xs mb-6 space-y-2">
        <div class="flex items-center justify-between">
          <span class="font-bold flex items-center gap-1 text-blue-900">
            <span>⏳</span>
            <span>Contact Modification Awaiting Executive Dual Sign-Off:</span>
          </span>
          <span id="pending-alert-date" class="text-[10px] text-blue-700 font-mono"></span>
        </div>
        <div class="grid grid-cols-1 sm:grid-cols-3 gap-2 pt-1 font-mono text-[11px] bg-white/70 p-2.5 rounded-lg border border-blue-200">
          <div>
            <span class="text-slate-400 block text-[9px] uppercase font-sans">Pending Email:</span>
            <span id="pending-alert-email" class="font-bold text-blue-900">-</span>
          </div>
          <div>
            <span class="text-slate-400 block text-[9px] uppercase font-sans">Pending Phone:</span>
            <span id="pending-alert-phone" class="font-bold text-blue-900">-</span>
          </div>
          <div>
            <span class="text-slate-400 block text-[9px] uppercase font-sans">Pending Address:</span>
            <span id="pending-alert-address" class="font-bold text-blue-900 truncate block">-</span>
          </div>
        </div>
        <p class="text-[10px] text-blue-700 italic">
          * Your current active contact details remain in effect for all official notices until the President and General Secretary verify and approve this request.
        </p>
      </div>

      <!-- Alert Box for Submit Feedback -->
      <div id="profile-status-alert" class="hidden p-3.5 rounded-xl text-xs mb-4"></div>

      <!-- Profile & KYC Form -->
      <form id="profile-form" onsubmit="handleProfileSubmit(event)" class="space-y-6 text-xs">

        <!-- 1. PASSPORT PHOTOGRAPH UPLOAD (10%) -->
        <div class="p-4 rounded-2xl bg-slate-50 border border-slate-200">
          <h4 class="font-bold text-wmcNavy-950 text-xs uppercase tracking-wider mb-3 flex items-center gap-1.5">
            <span>📷</span>
            <span>1. Official Passport Photograph (10% KYC)</span>
          </h4>
          <div class="flex flex-col sm:flex-row items-center gap-5">
            <div class="relative w-24 h-24 rounded-2xl bg-white border-2 border-dashed border-slate-300 flex items-center justify-center overflow-hidden shadow-inner group">
              <img id="profile-photo-preview" class="hidden w-full h-full object-cover" alt="Passport Preview" />
              <div id="profile-photo-placeholder" class="text-center p-2 text-slate-400">
                <span class="text-2xl block">👤</span>
                <span class="text-[10px] font-bold block mt-1">No Photo</span>
              </div>
            </div>
            <div class="flex-1 text-center sm:text-left space-y-2">
              <input type="file" id="profile-photo-file" accept="image/jpeg,image/png,image/webp" onchange="handlePassportPhotoUpload(event)" class="hidden" />
              <input type="hidden" id="profile-photo-base64" />
              <div class="flex flex-wrap items-center justify-center sm:justify-start gap-2">
                <button type="button" onclick="document.getElementById('profile-photo-file').click()" class="px-4 py-2 rounded-lg bg-wmcNavy-900 text-white font-bold hover:bg-wmcNavy-800 transition shadow-sm">
                  Upload Passport Photo...
                </button>
                <button type="button" id="btn-remove-photo" onclick="removePassportPhoto()" class="hidden px-3 py-2 rounded-lg border border-red-200 text-red-600 font-bold hover:bg-red-50 transition">
                  Remove Photo
                </button>
              </div>
              <p class="text-[10px] text-slate-400">
                Clear front-facing headshot on plain background (JPG, PNG, max 3MB). Stored securely with cooperator passbook.
              </p>
            </div>
          </div>
        </div>

        <!-- 2. PERSONAL INFORMATION (20%) -->
        <div class="p-4 rounded-2xl bg-slate-50 border border-slate-200 space-y-4">
          <h4 class="font-bold text-wmcNavy-950 text-xs uppercase tracking-wider flex items-center gap-1.5">
            <span>📋</span>
            <span>2. Personal Information (20% KYC)</span>
          </h4>
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
            <div>
              <label class="block font-bold text-slate-700 mb-1">Full Legal Name (Cooperator)</label>
              <input type="text" id="profile-full-name" readonly class="w-full p-2.5 rounded-lg border border-slate-200 bg-slate-100 text-slate-700 font-bold" title="Legal name changes require statutory resolution">
              <span class="text-[10px] text-slate-400 mt-1 block">Registered in MySQL standing registry</span>
            </div>
            <div>
              <label class="block font-bold text-slate-700 mb-1">Date of Birth</label>
              <input type="date" id="profile-dob" class="w-full p-2.5 rounded-lg border border-slate-300 bg-white">
            </div>
          </div>
          <div class="grid grid-cols-1 sm:grid-cols-3 gap-3">
            <div>
              <label class="block font-bold text-slate-700 mb-1">Gender</label>
              <select id="profile-gender" class="w-full p-2.5 rounded-lg border border-slate-300 bg-white">
                <option value="">Select Gender</option>
                <option value="MALE">Male</option>
                <option value="FEMALE">Female</option>
              </select>
            </div>
            <div>
              <label class="block font-bold text-slate-700 mb-1">Marital Status</label>
              <select id="profile-marital-status" class="w-full p-2.5 rounded-lg border border-slate-300 bg-white">
                <option value="">Select Status</option>
                <option value="SINGLE">Single</option>
                <option value="MARRIED">Married</option>
                <option value="DIVORCED">Divorced</option>
                <option value="WIDOWED">Widowed</option>
              </select>
            </div>
            <div>
              <label class="block font-bold text-slate-700 mb-1">Occupation / Employer</label>
              <input type="text" id="profile-occupation" placeholder="e.g. Accountant / Tech / Civil" class="w-full p-2.5 rounded-lg border border-slate-300 bg-white">
            </div>
          </div>
        </div>

        <!-- 3. IDENTITY & NATIONAL VERIFICATION (20%) -->
        <div class="p-4 rounded-2xl bg-slate-50 border border-slate-200 space-y-4">
          <h4 class="font-bold text-wmcNavy-950 text-xs uppercase tracking-wider flex items-center gap-1.5">
            <span>🏛️</span>
            <span>3. National Identity &amp; Verification (20% KYC)</span>
          </h4>
          <div class="grid grid-cols-1 sm:grid-cols-3 gap-3">
            <div>
              <label class="block font-bold text-slate-700 mb-1">National Identity Number (NIN) *</label>
              <input type="text" id="profile-nin" maxlength="11" placeholder="11-digit NIN" class="w-full p-2.5 rounded-lg border border-slate-300 bg-white font-mono font-bold">
              <span class="text-[10px] text-slate-400 mt-1 block">NIMC verified identity</span>
            </div>
            <div>
              <label class="block font-bold text-slate-700 mb-1">Bank Verification Number (BVN)</label>
              <input type="text" id="profile-bvn" maxlength="11" placeholder="11-digit BVN" class="w-full p-2.5 rounded-lg border border-slate-300 bg-white font-mono">
              <span class="text-[10px] text-slate-400 mt-1 block">CBN financial identity</span>
            </div>
            <div>
              <label class="block font-bold text-slate-700 mb-1">Membership Code</label>
              <input type="text" id="profile-member-code" readonly class="w-full p-2.5 rounded-lg border border-slate-200 bg-slate-100 text-slate-700 font-mono font-bold">
            </div>
          </div>
        </div>

        <!-- 4. STATUTORY CONTACT DETAILS (20% - Dual Sign-off Required) -->
        <div class="p-4 rounded-2xl bg-amber-50/50 border border-amber-300/60 space-y-4">
          <div class="flex flex-wrap items-center justify-between gap-2">
            <h4 class="font-bold text-amber-950 text-xs uppercase tracking-wider flex items-center gap-1.5">
              <span>📞</span>
              <span>4. Statutory Contact Information (20% KYC)</span>
            </h4>
            <span class="px-2 py-0.5 rounded text-[10px] font-black bg-amber-200 text-amber-900 border border-amber-300">
              ⚠️ Requires Dual Sign-Off (President &amp; General Secretary)
            </span>
          </div>
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
            <div>
              <div class="flex justify-between items-center mb-1">
                <label class="font-bold text-slate-700">Official Email Address *</label>
                <span id="badge-email-pending" class="hidden text-[9px] font-bold text-amber-700 bg-amber-100 px-1.5 py-0.2 rounded">Pending</span>
              </div>
              <input type="email" id="profile-email" required class="w-full p-2.5 rounded-lg border border-amber-300 bg-white focus:ring-2 focus:ring-amber-500">
              <span class="text-[10px] text-slate-500 mt-1 block">Active login &amp; AGM voting notice address</span>
            </div>
            <div>
              <div class="flex justify-between items-center mb-1">
                <label class="font-bold text-slate-700">Primary Phone Number *</label>
                <span id="badge-phone-pending" class="hidden text-[9px] font-bold text-amber-700 bg-amber-100 px-1.5 py-0.2 rounded">Pending</span>
              </div>
              <input type="tel" id="profile-phone" required class="w-full p-2.5 rounded-lg border border-amber-300 bg-white focus:ring-2 focus:ring-amber-500 font-mono">
              <span class="text-[10px] text-slate-500 mt-1 block">Official SMS &amp; WhatsApp communication line</span>
            </div>
          </div>
          <div>
            <div class="flex justify-between items-center mb-1">
              <label class="font-bold text-slate-700">Residential Address (Lagos State) *</label>
              <span id="badge-address-pending" class="hidden text-[9px] font-bold text-amber-700 bg-amber-100 px-1.5 py-0.2 rounded">Pending</span>
            </div>
            <textarea id="profile-address" rows="2" required class="w-full p-2.5 rounded-lg border border-amber-300 bg-white focus:ring-2 focus:ring-amber-500" placeholder="Physical residence in Lagos State"></textarea>
            <span class="text-[10px] text-slate-500 mt-1 block">Legal domicile for cooperative statutory notices</span>
          </div>
        </div>

        <!-- 5. SETTLEMENT BANK ACCOUNT (15%) -->
        <div class="p-4 rounded-2xl bg-slate-50 border border-slate-200 space-y-4">
          <h4 class="font-bold text-wmcNavy-950 text-xs uppercase tracking-wider flex items-center gap-1.5">
            <span>🏦</span>
            <span>5. Settlement Bank Account Details (15% KYC)</span>
          </h4>
          <p class="text-[11px] text-slate-500 -mt-2">
            Designated NUBAN account for dividend payouts, 0% interest loan disbursements, and member claims.
          </p>
          <div class="grid grid-cols-1 sm:grid-cols-3 gap-3">
            <div>
              <label class="block font-bold text-slate-700 mb-1">Commercial Bank Name *</label>
              <input type="text" id="profile-bank-name" placeholder="e.g. Polaris Bank, GTBank..." class="w-full p-2.5 rounded-lg border border-slate-300 bg-white">
            </div>
            <div>
              <label class="block font-bold text-slate-700 mb-1">NUBAN Account Number (10 digits) *</label>
              <input type="text" id="profile-bank-account-num" maxlength="10" placeholder="0123456789" class="w-full p-2.5 rounded-lg border border-slate-300 bg-white font-mono font-bold">
            </div>
            <div>
              <label class="block font-bold text-slate-700 mb-1">Account Holder Name *</label>
              <input type="text" id="profile-bank-account-name" placeholder="Must match cooperator name" class="w-full p-2.5 rounded-lg border border-slate-300 bg-white font-bold">
            </div>
          </div>
        </div>

        <!-- 6. NEXT OF KIN & EMERGENCY CONTACT (15%) -->
        <div class="p-4 rounded-2xl bg-slate-50 border border-slate-200 space-y-4">
          <h4 class="font-bold text-wmcNavy-950 text-xs uppercase tracking-wider flex items-center gap-1.5">
            <span>🤝</span>
            <span>6. Next of Kin &amp; Welfare Beneficiary (15% KYC)</span>
          </h4>
          <p class="text-[11px] text-slate-500 -mt-2">
            Statutory succession, welfare claim beneficiary, and emergency contact per Article 8 of WMC Bye-Laws.
          </p>
          <div class="grid grid-cols-1 sm:grid-cols-3 gap-3">
            <div>
              <label class="block font-bold text-slate-700 mb-1">Next of Kin Full Name *</label>
              <input type="text" id="profile-nok-name" placeholder="Full legal name" class="w-full p-2.5 rounded-lg border border-slate-300 bg-white font-bold">
            </div>
            <div>
              <label class="block font-bold text-slate-700 mb-1">Relationship to Member *</label>
              <input type="text" id="profile-nok-rel" placeholder="e.g. Spouse, Son, Daughter, Brother" class="w-full p-2.5 rounded-lg border border-slate-300 bg-white">
            </div>
            <div>
              <label class="block font-bold text-slate-700 mb-1">Next of Kin Phone *</label>
              <input type="tel" id="profile-nok-phone" placeholder="08012345678" class="w-full p-2.5 rounded-lg border border-slate-300 bg-white font-mono">
            </div>
          </div>
          <div>
            <label class="block font-bold text-slate-700 mb-1">Next of Kin Residential Address</label>
            <input type="text" id="profile-nok-address" placeholder="Physical residential address" class="w-full p-2.5 rounded-lg border border-slate-300 bg-white">
          </div>
        </div>

        <!-- Modal Submit Actions -->
        <div class="pt-4 border-t border-slate-200 flex flex-col sm:flex-row items-center justify-between gap-3">
          <span class="text-[11px] text-slate-400">
            Official Invariant: <a href="mailto:wealthbridge.coopsociety@gmail.com" class="text-amber-600 hover:underline">wealthbridge.coopsociety@gmail.com</a>
          </span>
          <div class="flex items-center gap-3 w-full sm:w-auto">
            <button type="button" onclick="closeProfileModal()" class="w-1/2 sm:w-auto px-5 py-3 rounded-xl border border-slate-300 text-slate-700 font-bold hover:bg-slate-50 transition">
              Cancel
            </button>
            <button type="submit" id="btn-save-profile" class="w-1/2 sm:w-auto px-8 py-3 rounded-xl btn-primary font-bold text-xs shadow-md flex items-center justify-center gap-2">
              <span>💾</span>
              <span>Save &amp; Update Profile</span>
            </button>
          </div>
        </div>

      </form>

    </div>
  </div>

  <!-- =========================================================================
       MODAL 4: 2× NON-INTEREST LOAN APPLICATION
       ========================================================================= -->
  <div id="modal-loan" class="fixed inset-0 z-50 bg-slate-950/60 backdrop-blur-sm hidden flex items-center justify-center p-4">
    <div class="glass-panel bg-white w-full max-w-lg rounded-3xl p-6 sm:p-8 shadow-2xl border border-slate-200">
      
      <div class="flex justify-between items-start mb-6">
        <div>
          <h3 class="text-xl font-bold text-wmcNavy-950">Apply for 2× Financing</h3>
          <p class="text-xs text-slate-500">Non-interest credit collateralized by your ordinary savings</p>
        </div>
        <button onclick="closeLoanModal()" class="text-slate-400 hover:text-slate-700 text-lg font-bold">✕</button>
      </div>

      <form id="loan-form" onsubmit="handleLoanSubmit(event)" class="space-y-4 text-xs">
        
        <div>
          <label class="block font-bold text-slate-700 mb-1">Requested Loan Amount (NGN) *</label>
          <input type="number" id="loan-request-amount" required min="10000" step="5000" placeholder="e.g. 50000" class="w-full p-2.5 rounded-lg border border-slate-300 font-bold text-sm">
          <span class="text-[10px] text-slate-400 mt-1 block">Maximum 2× your current unencumbered savings balance</span>
        </div>

        <div class="grid grid-cols-2 gap-3">
          <div>
            <label class="block font-bold text-slate-700 mb-1">Loan Product *</label>
            <select id="loan-product" class="w-full p-2.5 rounded-lg border border-slate-300 bg-white">
              <option value="1">Standard Micro-Credit (2×)</option>
              <option value="2">Asset Acquisition Credit</option>
              <option value="3">Emergency Medical Loan</option>
            </select>
          </div>
          <div>
            <label class="block font-bold text-slate-700 mb-1">Repayment Tenure *</label>
            <select id="loan-tenure" class="w-full p-2.5 rounded-lg border border-slate-300 bg-white">
              <option value="3">3 Months</option>
              <option value="6">6 Months</option>
              <option value="12">12 Months</option>
            </select>
          </div>
        </div>

        <div>
          <label class="block font-bold text-slate-700 mb-1">Financing Purpose *</label>
          <input type="text" id="loan-purpose" required placeholder="Business stock, home appliance, medical emergency, etc." class="w-full p-2.5 rounded-lg border border-slate-300">
        </div>

        <div>
          <label class="block font-bold text-slate-700 mb-1">Cooperative Guarantor Code *</label>
          <input type="text" id="loan-guarantor" required placeholder="e.g. WMC-2026-002" class="w-full p-2.5 rounded-lg border border-slate-300 font-mono">
          <span class="text-[10px] text-slate-400 mt-1 block">Must be an active member in good standing</span>
        </div>

        <div class="p-3 bg-amber-50 rounded-xl border border-amber-200 text-amber-900 text-[11px] space-y-1">
          <span class="font-bold block">Statutory Non-Interest Rule:</span>
          <p>Compounding interest is strictly 0.0%. A flat statutory administrative recovery cost is shared over the tenure per Article 14.</p>
        </div>

        <div class="pt-2">
          <button type="submit" class="w-full py-3 rounded-xl btn-primary font-bold text-xs shadow-md">
            Submit Loan Application to Credit Committee
          </button>
        </div>

      </form>

    </div>
  </div>

  <!-- =========================================================================
       MODAL 5: DISCIPLINARY FINE ISSUANCE (Financial Secretary / Legal Lead)
       ========================================================================= -->
  <div id="modal-fine" class="fixed inset-0 z-50 bg-slate-950/60 backdrop-blur-sm hidden flex items-center justify-center p-4">
    <div class="glass-panel bg-white w-full max-w-md rounded-3xl p-6 sm:p-8 shadow-2xl border border-slate-200">
      
      <div class="flex justify-between items-start mb-6">
        <div>
          <h3 class="text-xl font-bold text-wmcNavy-950">Issue Disciplinary Fine</h3>
          <p class="text-xs text-slate-500">Statutory penalty under Article 10 &amp; SOP Section 4</p>
        </div>
        <button onclick="closeIssueFineModal()" class="text-slate-400 hover:text-slate-700 text-lg font-bold">✕</button>
      </div>

      <form id="fine-form" onsubmit="handleFineSubmit(event)" class="space-y-4 text-xs">
        
        <div>
          <label class="block font-bold text-slate-700 mb-1">Target Member *</label>
          <select id="fine-member-id" required class="w-full p-2.5 rounded-lg border border-slate-300 bg-white">
            <!-- Populated via API -->
          </select>
        </div>

        <div>
          <label class="block font-bold text-slate-700 mb-1">Infraction Category *</label>
          <select id="fine-infraction" class="w-full p-2.5 rounded-lg border border-slate-300 bg-white">
            <option value="LATE_MONTHLY_REMITTANCE">Late Monthly Remittance (Past 28th)</option>
            <option value="MEETING_ABSENTEEISM">General Meeting Absenteeism (Without Apology)</option>
            <option value="MEETING_LATENESS">Meeting Lateness</option>
            <option value="CODE_OF_CONDUCT_BREACH">Code of Conduct Breach</option>
          </select>
        </div>

        <div>
          <label class="block font-bold text-slate-700 mb-1">Fine Amount (NGN) *</label>
          <input type="number" id="fine-amount" required min="1000" step="500" value="2000" class="w-full p-2.5 rounded-lg border border-slate-300 font-bold">
        </div>

        <div>
          <label class="block font-bold text-slate-700 mb-1">Factual Reason &amp; Reference *</label>
          <textarea id="fine-reason" required rows="2" placeholder="e.g. Failure to remit October 2026 savings contribution by statutory due date." class="w-full p-2.5 rounded-lg border border-slate-300"></textarea>
        </div>

        <div class="pt-2">
          <button type="submit" class="w-full py-3 rounded-xl bg-amber-600 hover:bg-amber-700 text-white font-bold text-xs shadow-md">
            Issue Official Disciplinary Fine
          </button>
        </div>

      </form>

    </div>
  </div>

