            </div>

            <!-- Global Action Bar -->
            <div class="flex flex-wrap items-center gap-2">
              <button type="button" id="btn-run-report" onclick="generateCurrentReport()" class="px-4 py-2.5 rounded-xl bg-gradient-to-r from-wmcNavy-950 to-indigo-900 hover:from-wmcNavy-900 hover:to-indigo-800 text-amber-300 font-bold text-xs shadow-md transition flex items-center gap-2 active:scale-95">
