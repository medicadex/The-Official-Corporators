                </p>

                <div class="space-y-3 text-xs mb-8 pt-4 border-t border-slate-100">
                  <div class="flex justify-between text-slate-700">
                    <span class="text-slate-500">Regular Savings:</span>
                    <span class="font-bold">₦8,000 / mo</span>
                  </div>
                  <div class="flex justify-between text-slate-700">
                    <span class="text-slate-500">Share Capital:</span>
                    <span class="font-bold">₦1,000 (1 unit)</span>
                  </div>
                  <div class="flex justify-between text-slate-700">
                    <span class="text-slate-500">Mutual Welfare:</span>
                    <span class="font-bold">₦1,000 / mo</span>
                  </div>
                  <div class="flex justify-between text-slate-700 pt-2 border-t border-slate-100">
                    <span class="text-slate-500">2× Credit Capacity:</span>
                    <span class="font-bold text-emerald-600">Up to ₦500,000</span>
                  </div>
                </div>
              </div>

              <button onclick="selectTierAndRegister('STANDARD')" class="w-full py-3 rounded-xl border border-emerald-600 text-emerald-700 hover:bg-emerald-600 hover:text-white font-bold text-xs transition">
