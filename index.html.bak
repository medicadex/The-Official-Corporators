          <div class="relative cursor-pointer group" onclick="openProfileModal()" title="Click to view & update passport photo and KYC profile">
            <div id="portal-avatar-box" class="w-16 h-16 rounded-2xl bg-gradient-to-br from-wmcNavy-950 to-wmcNavy-800 text-amber-300 flex items-center justify-center font-extrabold text-xl border-2 border-amber-400/40 shadow overflow-hidden">
