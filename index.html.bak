                  <div class="flex items-center gap-2">
                    <h4 class="text-base font-bold text-wmcNavy-950">Presidential Statutory Contact Sign-Off Queue</h4>
                    <span id="tab-pres-contact-badge" class="px-2 py-0.5 rounded-full text-[10px] font-black bg-amber-500 text-white">0</span>
                  </div>
                  <p class="text-xs text-slate-500">Dual-signoff governance: President and General Secretary authorization required for address, phone, and email modifications.</p>
                </div>
                <button onclick="loadPendingContactChanges()" class="text-xs text-amber-600 font-bold hover:underline">
                  ↻ Refresh Queue
                </button>
              </div>

              <div class="overflow-x-auto rounded-xl border border-slate-200">
                <table class="w-full text-left text-xs">
                  <thead class="bg-slate-50 text-slate-500 uppercase font-semibold">
                    <tr>
                      <th class="p-3">Member ID &amp; Name</th>
                      <th class="p-3">Modification Scope</th>
                      <th class="p-3">Current Active Values</th>
                      <th class="p-3">Proposed New Values</th>
                      <th class="p-3">Requested At</th>
                      <th class="p-3 text-right">Presidential Action</th>
                    </tr>
                  </thead>
                  <tbody id="pending-contact-pres-tbody" class="divide-y divide-slate-100">
                    <tr>
                      <td colspan="6" class="p-4 text-center text-slate-400">Loading pending contact modifications...</td>
                    </tr>
                  </tbody>
                </table>
              </div>
            </div>
          </div>

        </div>

        <div class="mt-8 pt-4 border-t border-slate-800 text-[10px] text-slate-400 relative z-10">
