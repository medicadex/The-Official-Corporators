                <div class="absolute -right-12 -top-12 w-48 h-48 bg-amber-400/10 rounded-full blur-2xl pointer-events-none"></div>
                <div class="absolute -left-12 -bottom-12 w-48 h-48 bg-emerald-400/10 rounded-full blur-2xl pointer-events-none"></div>

                <div class="relative z-10">
                  <div class="flex items-center justify-between mb-4">
                    <span class="px-3 py-1 rounded-md bg-wmcNavy-900 text-amber-300 font-mono text-[11px] font-semibold">
                      CONSTITUTIONAL INVARIANT
                    </span>
                    <span class="text-xs text-slate-400 font-medium">SOP-WMC-2026-V1</span>
                  </div>

                  <h3 class="text-xl font-bold text-wmcNavy-950 mb-2">Our New Era of Collective Prosperity</h3>
