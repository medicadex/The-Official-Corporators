              <div>
                <h4 class="font-bold text-sm">Disciplinary Enforcement &amp; Statutory Fine Desk</h4>
                <p class="text-xs text-amber-800">Issue official fines for late remittance or meeting absenteeism per Article 10 of WMC Bye-Laws.</p>
              </div>
              <button onclick="openIssueFineModal()" class="px-4 py-2 text-xs font-bold rounded-lg bg-amber-600 hover:bg-amber-700 text-white transition shadow-sm">
                ➕ Issue Disciplinary Fine
              </button>
            </div>

            <div>
              <h4 class="text-base font-bold text-wmcNavy-950 mb-2">Remittance Inward Reconciliation Desk</h4>
              <p class="text-xs text-slate-500 mb-4">Polaris Bank deposit ledger syncs automatically via stored procedure `process_monthly_contribution`.</p>
              
              <div class="p-4 bg-slate-50 rounded-xl border border-slate-200 text-xs space-y-2">
                <div class="flex justify-between">
                  <span class="text-slate-500">Designated Inward Account:</span>
                  <span class="font-bold text-slate-800">Polaris Bank Limited &bull; Wealthbridge Multipurpose Coop</span>
                </div>
                <div class="flex justify-between">
                  <span class="text-slate-500">Statutory Allocation Rule:</span>
                  <span class="font-bold text-slate-800">Savings (Balance) &bull; Shares (10%) &bull; Welfare (Fixed ₦1,000)</span>
                </div>
                <div class="flex justify-between">
                  <span class="text-slate-500">Monthly Contribution Due Day:</span>
                  <span class="font-bold text-slate-800">28th of every month</span>
                </div>
              </div>
            </div>
          </div>

          <!-- DESK 2.5: TARGET SAVINGS DESK (EXECUTIVE OVERSIGHT) -->
          <div id="desk-targets" class="hidden space-y-6">
            <div class="flex flex-col md:flex-row md:items-center justify-between gap-4 p-5 rounded-2xl bg-gradient-to-r from-slate-900 via-teal-950 to-slate-900 text-white border border-teal-800/40 shadow-md">
              <div>
                <div class="flex items-center gap-2 mb-1">
                  <span class="px-2 py-0.5 rounded bg-teal-400 text-slate-950 text-[10px] font-extrabold uppercase tracking-wider">Executive Oversight</span>
                  <h4 class="font-bold text-base font-serif-title">Dynamic Target Savings Ledgers Registry</h4>
                </div>
                <p class="text-xs text-teal-200">
                  Comprehensive audit of member voluntary target savings ledgers, goal amounts, and maturity schedules.
                </p>
              </div>
              <button onclick="loadAdminTargetSavings()" class="px-4 py-2 text-xs font-bold rounded-xl bg-teal-500 hover:bg-teal-400 text-slate-950 transition shadow-sm flex items-center gap-1.5">
                <span>↻ Refresh Target Pool</span>
              </button>
            </div>

            <!-- Categories Aggregates Cards -->
            <div id="admin-target-categories-grid" class="grid grid-cols-2 sm:grid-cols-4 lg:grid-cols-7 gap-3 text-xs">
              <!-- Dynamically populated -->
            </div>

            <!-- All Members Target Ledgers Table -->
            <div class="overflow-x-auto rounded-xl border border-slate-200">
              <table class="w-full text-left text-xs">
                <thead class="bg-slate-50 text-slate-500 uppercase font-semibold">
                  <tr>
                    <th class="p-3">Cooperator</th>
                    <th class="p-3">Category &amp; Title</th>
                    <th class="p-3">Goal Amount</th>
                    <th class="p-3">Saved Balance</th>
                    <th class="p-3">Progress</th>
                    <th class="p-3">Maturity Date</th>
                    <th class="p-3">Status</th>
                  </tr>
                </thead>
                <tbody id="admin-target-ledgers-tbody" class="divide-y divide-slate-100">
                  <tr>
                    <td colspan="7" class="p-4 text-center text-slate-400">Loading society target savings ledgers...</td>
                  </tr>
                </tbody>
              </table>
            </div>
          </div>

          <!-- DESK 3: PRESIDENTIAL & BOARD OVERSIGHT -->
          <div id="desk-pres" class="hidden space-y-6">
            <div>
              <h4 class="text-base font-bold text-wmcNavy-950 mb-2">Credit Committee &amp; Loan Governance</h4>
              <p class="text-xs text-slate-500 mb-4">Statutory 2× borrowing multiplier backed by 100% unencumbered ordinary savings and cross-guarantors.</p>
              
              <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
                <div class="p-4 bg-white rounded-xl border border-slate-200">
                  <span class="text-xs font-bold text-slate-500 block uppercase">Standard Loan Ratio</span>
                  <h5 class="text-xl font-extrabold text-wmcNavy-950 mt-1">2.0× Liquid Savings</h5>
                  <p class="text-[11px] text-slate-500 mt-1">Requires 6 consecutive months active standing</p>
                </div>
                <div class="p-4 bg-white rounded-xl border border-slate-200">
                  <span class="text-xs font-bold text-slate-500 block uppercase">Compounding Interest</span>
                  <h5 class="text-xl font-extrabold text-emerald-600 mt-1">0.0% Strict Invariant</h5>
                  <p class="text-[11px] text-slate-500 mt-1">Flat administrative cost recovery only</p>
                </div>
                <div class="p-4 bg-white rounded-xl border border-slate-200">
                  <span class="text-xs font-bold text-slate-500 block uppercase">Democratic Ratio</span>
                  <h5 class="text-xl font-extrabold text-purple-700 mt-1">1 Member = 1 Vote</h5>
                  <p class="text-[11px] text-slate-500 mt-1">Anti-monopoly shareholding cap: 20% max</p>
                </div>
              </div>
            </div>
          </div>

          <!-- DESK 4: SYSTEMS & AUDIT DESK -->
          <div id="desk-admin" class="hidden space-y-6">
            <div class="glass-panel p-6 rounded-2xl border border-slate-200 shadow-sm space-y-4">
              <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 pb-3 border-b border-slate-200">
                <div>
                  <div class="flex items-center gap-2 mb-1">
                    <span class="px-2 py-0.5 rounded text-[10px] font-black uppercase tracking-wider bg-indigo-100 text-indigo-900 border border-indigo-200">
                      MySQL system_config
                    </span>
                    <span class="text-xs text-slate-400 font-mono">Live Platform Parameters</span>
                  </div>
                  <h4 class="text-base font-bold text-wmcNavy-950">System Constants &amp; Statutory Config</h4>
                  <p class="text-xs text-slate-500">
                    Values loaded dynamically from MySQL table <code>system_config</code>. Authorized administrators can adjust regulatory and operational parameters directly.
                  </p>
                </div>
                <div class="flex items-center gap-2">
                  <button type="button" onclick="loadSystemConfigTable()" class="px-3.5 py-2 rounded-xl border border-slate-300 hover:bg-slate-100 text-slate-700 text-xs font-bold transition flex items-center gap-1.5 shadow-sm active:scale-95">
                    <span>↻</span>
                    <span>Refresh Parameters</span>
                  </button>
                </div>
              </div>
              
              <div class="overflow-x-auto rounded-xl border border-slate-200">
                <table class="w-full text-left text-xs">
                  <thead class="bg-slate-50 text-slate-500 uppercase font-semibold text-[11px] tracking-wider">
                    <tr>
                      <th class="p-3">Config Key</th>
                      <th class="p-3">Current Value</th>
                      <th class="p-3">Statutory Description</th>
                      <th class="p-3">Last Modified</th>
                      <th class="p-3 text-center">Action</th>
                    </tr>
                  </thead>
                  <tbody id="system-config-tbody" class="divide-y divide-slate-100 text-slate-700">
                    <!-- Populated via API -->
                    <tr>
                      <td colspan="5" class="p-4 text-center text-slate-400">Loading system parameters...</td>
                    </tr>
                  </tbody>
                </table>
              </div>
            </div>

            <!-- Database Testing Actions -->
            <div class="p-5 rounded-2xl bg-slate-900 text-white space-y-3">
              <h5 class="font-bold text-amber-400 text-sm">Testing &amp; Environment Operations</h5>
              <p class="text-xs text-slate-400">Manage test database records directly from the platform.</p>
              <div class="flex flex-wrap items-center gap-3 pt-2">
                <button onclick="confirmResetDatabase()" class="px-4 py-2 rounded-lg bg-red-600 hover:bg-red-700 text-white font-bold text-xs transition">
                  🗑️ Wipe Test Transactions &amp; Members
                </button>
                <button onclick="confirmSeedDatabase()" class="px-4 py-2 rounded-lg bg-emerald-600 hover:bg-emerald-700 text-white font-bold text-xs transition">
                  🌱 Re-Seed 8 Founding Members
                </button>
              </div>
            </div>
          </div>

        </div>

      </div>

    </div>

  </main>

  <!-- =========================================================================
       MODAL 1: NEW MEMBER REGISTRATION & ONBOARDING
       ========================================================================= -->
  <div id="modal-registration" class="fixed inset-0 z-50 bg-slate-950/60 backdrop-blur-sm hidden flex items-center justify-center p-4">
    <div class="glass-panel bg-white w-full max-w-xl rounded-3xl p-6 sm:p-8 shadow-2xl border border-slate-200 max-h-[90vh] overflow-y-auto">
      
      <div class="flex justify-between items-start mb-6">
        <div>
          <h3 class="text-xl font-bold text-wmcNavy-950">Join Wealthbridge Society</h3>
          <p class="text-xs text-slate-500">Official Membership Registration &bull; Lagos State Cooperative Law</p>
        </div>
        <button onclick="closeRegistrationModal()" class="text-slate-400 hover:text-slate-700 text-lg font-bold">✕</button>
      </div>

      <!-- Live Dynamic Alert Box (Error / Duplicate / Success) -->
      <div id="reg-status-alert" class="hidden p-3.5 rounded-xl text-xs mb-4"></div>

      <form id="registration-form" onsubmit="handleRegistrationSubmit(event)" class="space-y-4 text-xs">
        
        <div class="grid grid-cols-2 gap-3">
          <div>
            <label class="block font-bold text-slate-700 mb-1">First Name *</label>
            <input type="text" id="reg-first-name" required placeholder="e.g. Babatunde" class="w-full p-2.5 rounded-lg border border-slate-300">
          </div>
          <div>
            <label class="block font-bold text-slate-700 mb-1">Last Name *</label>
            <input type="text" id="reg-last-name" required placeholder="e.g. Adeleke" class="w-full p-2.5 rounded-lg border border-slate-300">
          </div>
        </div>

        <div class="grid grid-cols-2 gap-3">
          <div>
            <label class="block font-bold text-slate-700 mb-1">Email Address *</label>
            <input type="email" id="reg-email" required placeholder="you@domain.com" class="w-full p-2.5 rounded-lg border border-slate-300">
          </div>
          <div>
            <label class="block font-bold text-slate-700 mb-1">Phone Number *</label>
            <input type="tel" id="reg-phone" required placeholder="08012345678" class="w-full p-2.5 rounded-lg border border-slate-300">
          </div>
        </div>

        <div class="grid grid-cols-2 gap-3">
          <div>
            <label class="block font-bold text-slate-700 mb-1">Employment / Occupation *</label>
            <select id="reg-employment" class="w-full p-2.5 rounded-lg border border-slate-300 bg-white">
              <option value="SALARY_EARNER">Salary Earner / Corporate</option>
              <option value="PROFESSIONAL">Licensed Professional</option>
              <option value="BUSINESS_OWNER">Registered Business Owner</option>
            </select>
          </div>
          <div>
            <label class="block font-bold text-slate-700 mb-1">Contribution Tier *</label>
            <select id="reg-tier" class="w-full p-2.5 rounded-lg border border-slate-300 bg-white">
              <option value="STANDARD">Standard Tier (₦10,000 / month)</option>
              <option value="PLUS">Plus Tier (₦25,000 / month)</option>
              <option value="PREMIUM">Premium Tier (₦50,000+ / month)</option>
            </select>
          </div>
        </div>

        <div>
          <label class="block font-bold text-slate-700 mb-1">Residential Address (Lagos State) *</label>
          <input type="text" id="reg-address" required placeholder="Street address, City" class="w-full p-2.5 rounded-lg border border-slate-300">
        </div>

        <div>
          <div class="flex justify-between items-center mb-1">
            <label class="block font-bold text-slate-700">Access Password (Optional)</label>
            <span class="text-[10px] text-slate-400">Default: Wealthbridge@2026</span>
          </div>
          <input type="password" id="reg-password" placeholder="Set password or leave blank for default (Wealthbridge@2026)" class="w-full p-2.5 rounded-lg border border-slate-300">
          <span class="text-[10px] text-slate-400 block mt-1">If left blank, your default sign-in password will be <b>Wealthbridge@2026</b>.</span>
        </div>

        <!-- Statutory Fee Notice Box -->
        <div class="p-4 rounded-xl bg-slate-100 border border-slate-300 text-slate-700 space-y-1">
          <span class="font-bold block text-wmcNavy-950">Statutory Onboarding Breakdown:</span>
          <p>&bull; <strong>₦5,000</strong> One-time Non-refundable Entrance Fee</p>
          <p>&bull; <strong>₦2,000</strong> Cooperative Passbook &amp; Digital ID Issuance</p>
          <p>&bull; <strong>₦5,000</strong> Minimum 5 Share Units (Mandatory for Loan &amp; Voting Qualification)</p>
        </div>

        <div class="pt-2">
          <button type="submit" class="w-full py-3 rounded-xl btn-accent font-bold text-xs shadow-md">
            Submit Application &amp; Generate Member ID
          </button>
        </div>

      </form>

    </div>
  </div>

  <!-- =========================================================================
       MODAL 2: MONTHLY REMITTANCE SUBMISSION
       ========================================================================= -->
  <div id="modal-contribution" class="fixed inset-0 z-50 bg-slate-950/60 backdrop-blur-sm hidden flex items-center justify-center p-4">
    <div class="glass-panel bg-white w-full max-w-md rounded-3xl p-6 sm:p-8 shadow-2xl border border-slate-200">
      
      <div class="flex justify-between items-start mb-6">
        <div>
          <h3 class="text-xl font-bold text-wmcNavy-950">Remit Monthly Contribution</h3>
          <p class="text-xs text-slate-500">Automated 3-Way Tripartite Ledger Allocation</p>
        </div>
        <button onclick="closeContributionModal()" class="text-slate-400 hover:text-slate-700 text-lg font-bold">✕</button>
      </div>

      <form id="contribution-form" onsubmit="handleContributionSubmit(event)" class="space-y-4 text-xs">
        
        <div>
          <label class="block font-bold text-slate-700 mb-1">Remittance Amount (NGN) *</label>
          <input type="number" id="contrib-amount" required min="10000" step="1000" value="10000" class="w-full p-2.5 rounded-lg border border-slate-300 font-bold text-sm">
          <span class="text-[10px] text-slate-400 mt-1 block">Baseline: ₦10,000 (Standard) | ₦25,000 (Plus) | ₦50,000 (Premium)</span>
        </div>

        <div>
          <label class="block font-bold text-slate-700 mb-1">Payment Method *</label>
          <select id="contrib-method" class="w-full p-2.5 rounded-lg border border-slate-300 bg-white">
            <option value="POLARIS_BANK_TRANSFER">Polaris Bank Direct Transfer</option>
            <option value="DIRECT_DEBIT">Standing Direct Debit Mandate</option>
            <option value="ONLINE_GATEWAY">Verified Online Payment Gateway</option>
          </select>
        </div>

        <div>
          <label class="block font-bold text-slate-700 mb-1">Bank Teller / Channel Reference *</label>
          <input type="text" id="contrib-ref" required placeholder="e.g. POLARIS-TRF-2026-987" class="w-full p-2.5 rounded-lg border border-slate-300 font-mono">
        </div>

        <div class="p-3 bg-emerald-50 rounded-xl border border-emerald-200 text-emerald-900 space-y-1 text-[11px]">
          <span class="font-bold block">Live SOP Split Simulation:</span>
          <p id="split-preview-text">₦8,000 &rarr; Savings | ₦1,000 &rarr; Shares | ₦1,000 &rarr; Welfare</p>
        </div>

        <div class="pt-2">
          <button type="submit" class="w-full py-3 rounded-xl btn-primary font-bold text-xs shadow-md">
            Confirm &amp; Post to MySQL Database
          </button>
        </div>

      </form>

    </div>
  </div>

  <!-- =========================================================================
       MODAL: CREATE TARGET SAVINGS LEDGER
       ========================================================================= -->
  <div id="modal-create-target-savings" class="fixed inset-0 z-50 bg-slate-950/70 backdrop-blur-md hidden flex items-center justify-center p-4 overflow-y-auto">
    <div class="glass-panel bg-white w-full max-w-lg rounded-3xl p-6 sm:p-8 shadow-2xl border border-slate-200 my-8">
      
      <div class="flex justify-between items-start mb-5">
        <div>
          <div class="flex items-center gap-2 mb-1">
            <span class="px-2 py-0.5 rounded-full bg-emerald-100 text-emerald-800 text-[10px] font-extrabold uppercase tracking-wider">
              Voluntary Ledger
            </span>
            <span class="px-2 py-0.5 rounded-full bg-blue-100 text-blue-800 text-[10px] font-bold">
              Non-Compulsory
            </span>
          </div>
          <h3 class="text-xl font-bold font-serif-title text-wmcNavy-950">Create Target Savings Ledger</h3>
          <p class="text-xs text-slate-500">Pick a standardized category and set your proposed maturity date.</p>
        </div>
        <button type="button" onclick="closeCreateTargetSavingsModal()" class="text-slate-400 hover:text-slate-700 text-lg font-bold">✕</button>
      </div>

      <div id="create-target-alert" class="hidden p-3.5 rounded-xl text-xs mb-4"></div>

      <form id="form-create-target-savings" onsubmit="handleCreateTargetSavingsSubmit(event)" class="space-y-4 text-xs">
        
        <!-- Standard Uniform Dropdown -->
        <div>
          <label class="block font-bold text-slate-700 mb-1.5 flex items-center justify-between">
            <span>Standard Target Category *</span>
            <span class="text-[10px] text-slate-400 font-normal">Uniform co-op standard</span>
          </label>
          <select id="target-type-select" onchange="handleTargetTypeChange(this.value)" class="w-full p-3 rounded-xl border border-slate-300 bg-white font-semibold text-slate-800 focus:ring-2 focus:ring-emerald-500 focus:outline-none transition" required>
            <option value="" disabled selected>-- Select Standard Target Category --</option>
            <option value="BIRTHDAY">🎂 Birthday Target</option>
            <option value="CHRISTMAS">🎄 Christmas Target</option>
            <option value="ILEYA">🐑 Ileya Target</option>
            <option value="BUILDING">🏗️ Building Target</option>
            <option value="PILGRIMAGE">✈️ Pilgrimage Target (Hajj &amp; Jerusalem)</option>
            <option value="EDUCATION">🎓 Education Target</option>
            <option value="OTHERS">🎯 Others (Custom Financial Goal)</option>
          </select>
        </div>

        <!-- Custom Ledger Title -->
        <div>
          <label class="block font-bold text-slate-700 mb-1">
            Target Ledger Title *
          </label>
          <input type="text" id="target-title-input" class="w-full p-2.5 rounded-xl border border-slate-300 focus:ring-2 focus:ring-emerald-500 focus:outline-none" placeholder="e.g. 2027 Ileya Ram & Family Feast Target" required>
          <p class="text-[10px] text-slate-400 mt-0.5">Auto-suggested from category, or specify a custom goal description.</p>
        </div>

        <!-- Financial Goal Amount -->
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
          <div>
            <label class="block font-bold text-slate-700 mb-1">
              Financial Target Goal (₦) *
            </label>
            <input type="number" id="target-amount-input" min="5000" step="1000" class="w-full p-2.5 rounded-xl border border-slate-300 font-mono font-bold focus:ring-2 focus:ring-emerald-500 focus:outline-none" placeholder="500000" required>
            <p class="text-[10px] text-slate-400 mt-0.5">Minimum ₦5,000.00</p>
          </div>

          <!-- Proposed Maturity Date -->
          <div>
            <label class="block font-bold text-slate-700 mb-1 flex items-center justify-between">
              <span>Proposed Maturity Date *</span>
              <span class="text-[10px] text-emerald-700 font-bold">Lock Date</span>
            </label>
            <input type="date" id="target-maturity-date" class="w-full p-2.5 rounded-xl border border-slate-300 font-mono focus:ring-2 focus:ring-emerald-500 focus:outline-none" required>
            <p class="text-[10px] text-slate-400 mt-0.5">Must be in the future (unlocks withdrawal)</p>
          </div>
        </div>

        <!-- Initial Deposit & Auto-Save -->
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
          <div>
            <label class="block font-bold text-slate-700 mb-1">
              Initial Deposit Allocation (₦)
            </label>
            <input type="number" id="target-initial-deposit" min="0" step="500" class="w-full p-2.5 rounded-xl border border-slate-300 font-mono" placeholder="0 (Optional)">
            <p class="text-[10px] text-slate-400 mt-0.5">Start ledger with an immediate top-up</p>
          </div>

          <div>
            <label class="block font-bold text-slate-700 mb-1">
              Monthly Auto-Save Plan (₦)
            </label>
            <input type="number" id="target-auto-save" min="0" step="500" class="w-full p-2.5 rounded-xl border border-slate-300 font-mono" placeholder="0 (Optional)">
            <p class="text-[10px] text-slate-400 mt-0.5">Target monthly contribution guide</p>
          </div>
        </div>

        <!-- Payment Method -->
        <div id="target-payment-method-box">
          <label class="block font-bold text-slate-700 mb-1">Payment Method</label>
          <select id="target-payment-method" class="w-full p-2.5 rounded-xl border border-slate-300 bg-white">
            <option value="POLARIS_BANK_TRANSFER">Polaris Bank Transfer / Direct Remittance</option>
            <option value="INTERNAL_SET_OFF">Internal Transfer from Co-op Available Savings</option>
          </select>
        </div>

        <!-- Disciplinary & Governance Notice -->
        <div class="p-3.5 rounded-xl bg-amber-50 border border-amber-200 text-amber-950 text-[11px] space-y-1">
          <div class="font-bold flex items-center gap-1.5 text-amber-900">
            <span>⚖️</span>
            <span>Voluntary Distinction &amp; Maturity Lock Rule:</span>
          </div>
          <p class="leading-relaxed">
            Target Savings is <strong>voluntary</strong> and completely separate from mandatory Welfare Solidarity pool contributions. Deposited funds earn cooperative dividend yields and remain locked until the proposed maturity date to safeguard personal goal discipline. At maturity, funds become <strong>100% withdrawable</strong> to your registered commercial bank account.
          </p>
        </div>

        <div class="flex items-center gap-3 pt-3">
          <button type="button" onclick="closeCreateTargetSavingsModal()" class="flex-1 py-3 rounded-xl border border-slate-300 hover:bg-slate-100 text-slate-700 font-bold transition">
            Cancel
          </button>
          <button type="submit" id="btn-submit-create-target" class="flex-1 py-3 rounded-xl bg-gradient-to-r from-emerald-600 to-teal-700 hover:from-emerald-500 hover:to-teal-600 text-white font-black shadow-md transition flex items-center justify-center gap-2">
            <span>Create Target Ledger</span>
            <span>&rarr;</span>
          </button>
        </div>

      </form>
    </div>
  </div>

  <!-- =========================================================================
       MODAL: TOP UP / DEPOSIT INTO TARGET SAVINGS LEDGER
       ========================================================================= -->
  <div id="modal-deposit-target-savings" class="fixed inset-0 z-50 bg-slate-950/70 backdrop-blur-md hidden flex items-center justify-center p-4">
    <div class="glass-panel bg-white w-full max-w-md rounded-3xl p-6 sm:p-8 shadow-2xl border border-slate-200">
      
      <div class="flex justify-between items-start mb-4">
        <div>
          <span class="px-2 py-0.5 rounded-full bg-emerald-100 text-emerald-800 text-[10px] font-extrabold uppercase tracking-wider block w-fit mb-1">
            Top-Up Deposit
          </span>
          <h3 class="text-xl font-bold font-serif-title text-wmcNavy-950">Top Up Target Savings</h3>
          <p class="text-xs text-slate-500" id="deposit-target-subtitle">Credit funds towards your financial target.</p>
        </div>
        <button type="button" onclick="closeDepositTargetSavingsModal()" class="text-slate-400 hover:text-slate-700 text-lg font-bold">✕</button>
      </div>

      <div id="deposit-target-alert" class="hidden p-3.5 rounded-xl text-xs mb-4"></div>

      <form id="form-deposit-target-savings" onsubmit="handleDepositTargetSavingsSubmit(event)" class="space-y-4 text-xs">
        <input type="hidden" id="deposit-target-id">

        <!-- Ledger Info Card -->
        <div class="p-3.5 rounded-xl bg-slate-50 border border-slate-200 space-y-1.5">
          <div class="flex justify-between">
            <span class="text-slate-500">Ledger Name:</span>
            <strong id="deposit-target-title-display" class="text-wmcNavy-950 text-right">---</strong>
          </div>
          <div class="flex justify-between">
            <span class="text-slate-500">Current Balance:</span>
            <strong id="deposit-target-balance-display" class="font-mono text-emerald-700">₦0.00</strong>
          </div>
          <div class="flex justify-between">
            <span class="text-slate-500">Financial Target:</span>
            <strong id="deposit-target-goal-display" class="font-mono text-slate-700">₦0.00</strong>
          </div>
          <div class="flex justify-between pt-1 border-t border-slate-200 text-[11px]">
            <span class="text-slate-500">Proposed Maturity:</span>
            <strong id="deposit-target-date-display" class="font-mono text-blue-700">---</strong>
          </div>
        </div>

        <div>
          <label class="block font-bold text-slate-700 mb-1">Deposit Amount (₦) *</label>
          <input type="number" id="deposit-target-amount" min="1000" step="500" class="w-full p-2.5 rounded-xl border border-slate-300 font-mono font-bold text-sm focus:ring-2 focus:ring-emerald-500 focus:outline-none" placeholder="25000" required>
        </div>

        <div>
          <label class="block font-bold text-slate-700 mb-1">Payment Channel</label>
          <select id="deposit-target-method" class="w-full p-2.5 rounded-xl border border-slate-300 bg-white">
            <option value="POLARIS_BANK_TRANSFER">Polaris Bank Transfer / Inward Remittance</option>
            <option value="INTERNAL_SET_OFF">Internal Transfer from Co-op Regular Savings</option>
          </select>
        </div>

        <div>
          <label class="block font-bold text-slate-700 mb-1">Bank Narration / Deposit Reference</label>
          <input type="text" id="deposit-target-narration" class="w-full p-2.5 rounded-xl border border-slate-300" placeholder="Optional deposit reference">
        </div>

        <div class="flex items-center gap-3 pt-2">
          <button type="button" onclick="closeDepositTargetSavingsModal()" class="flex-1 py-2.5 rounded-xl border border-slate-300 hover:bg-slate-100 text-slate-700 font-bold transition">
            Cancel
          </button>
          <button type="submit" id="btn-submit-deposit-target" class="flex-1 py-2.5 rounded-xl bg-emerald-600 hover:bg-emerald-700 text-white font-black shadow-md transition flex items-center justify-center gap-1.5">
            <span>Confirm Deposit</span>
          </button>
        </div>

      </form>
    </div>
  </div>

  <!-- =========================================================================
       MODAL: WITHDRAW MATURED TARGET SAVINGS (PAYOUT TO BANK)
       ========================================================================= -->
  <div id="modal-withdraw-target-savings" class="fixed inset-0 z-50 bg-slate-950/70 backdrop-blur-md hidden flex items-center justify-center p-4">
    <div class="glass-panel bg-white w-full max-w-lg rounded-3xl p-6 sm:p-8 shadow-2xl border border-slate-200">
      
      <div class="flex justify-between items-start mb-4">
        <div>
          <span class="px-2 py-0.5 rounded-full bg-amber-100 text-amber-800 text-[10px] font-extrabold uppercase tracking-wider block w-fit mb-1">
            🎉 Maturity Payout
          </span>
          <h3 class="text-xl font-bold font-serif-title text-wmcNavy-950">Withdraw Matured Target Savings</h3>
          <p class="text-xs text-slate-500">Congratulations! Your target has reached maturity and funds are unlocked.</p>
        </div>
        <button type="button" onclick="closeWithdrawTargetSavingsModal()" class="text-slate-400 hover:text-slate-700 text-lg font-bold">✕</button>
      </div>

      <div id="withdraw-target-alert" class="hidden p-3.5 rounded-xl text-xs mb-4"></div>

      <form id="form-withdraw-target-savings" onsubmit="handleWithdrawTargetSavingsSubmit(event)" class="space-y-4 text-xs">
        <input type="hidden" id="withdraw-target-id">

        <!-- Target Ledger Summary -->
        <div class="p-4 rounded-xl bg-gradient-to-br from-amber-50 to-orange-50/50 border border-amber-200 space-y-2">
          <div class="flex justify-between">
            <span class="text-slate-600">Matured Ledger:</span>
            <strong id="withdraw-target-title-display" class="text-wmcNavy-950 text-right">---</strong>
          </div>
          <div class="flex justify-between">
            <span class="text-slate-600">Available Matured Balance:</span>
            <strong id="withdraw-target-balance-display" class="font-mono text-base font-black text-emerald-700">₦0.00</strong>
          </div>
          <div class="flex justify-between text-[11px] pt-1 border-t border-amber-200">
            <span class="text-slate-600">Maturity Date:</span>
            <strong id="withdraw-target-date-display" class="font-mono text-amber-900">---</strong>
          </div>
        </div>

        <div>
          <div class="flex justify-between items-center mb-1">
            <label class="block font-bold text-slate-700">Withdrawal Amount (₦) *</label>
            <button type="button" onclick="setWithdrawAllTargetAmount()" class="text-[11px] font-bold text-blue-700 hover:underline">
              Withdraw All
            </button>
          </div>
          <input type="number" id="withdraw-target-amount" min="1000" step="100" class="w-full p-2.5 rounded-xl border border-slate-300 font-mono font-bold text-sm focus:ring-2 focus:ring-amber-500 focus:outline-none" required>
        </div>

        <!-- Destination Commercial Bank Details -->
        <div class="p-4 rounded-xl bg-slate-50 border border-slate-200 space-y-3">
          <h4 class="font-bold text-slate-800 uppercase tracking-wider text-[11px] flex items-center gap-1.5">
            <span>🏦</span>
            <span>Settlement Commercial Bank (KYC Account)</span>
          </h4>
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
            <div>
              <label class="block font-bold text-slate-600 mb-1">Bank Name</label>
              <input type="text" id="withdraw-bank-name" class="w-full p-2 rounded-lg border border-slate-300 bg-white" placeholder="e.g. Polaris Bank" required>
            </div>
            <div>
              <label class="block font-bold text-slate-600 mb-1">Account Number</label>
              <input type="text" id="withdraw-bank-account" class="w-full p-2 rounded-lg border border-slate-300 bg-white font-mono" maxlength="10" placeholder="10-digit NUBAN" required>
            </div>
          </div>
          <div>
            <label class="block font-bold text-slate-600 mb-1">Account Name</label>
            <input type="text" id="withdraw-bank-name-holder" class="w-full p-2 rounded-lg border border-slate-300 bg-white" placeholder="Cooperator Full Name as on Bank Account" required>
          </div>
          <p class="text-[10px] text-slate-400">
            * Payouts are remitted directly from the Wealthbridge Polaris Bank custody treasury.
          </p>
        </div>

        <div class="flex items-center gap-3 pt-2">
          <button type="button" onclick="closeWithdrawTargetSavingsModal()" class="flex-1 py-3 rounded-xl border border-slate-300 hover:bg-slate-100 text-slate-700 font-bold transition">
            Cancel
          </button>
          <button type="submit" id="btn-submit-withdraw-target" class="flex-1 py-3 rounded-xl bg-gradient-to-r from-amber-600 to-amber-700 hover:from-amber-500 hover:to-amber-600 text-white font-black shadow-md transition flex items-center justify-center gap-2">
            <span>Process Bank Payout</span>
            <span>&rarr;</span>
          </button>
        </div>

      </form>
    </div>
  </div>

  <!-- =========================================================================
       PAYSTACK CHECKOUT / ONLINE PAYMENT MODAL
       ========================================================================= -->
  <div id="modal-paystack-payment" class="fixed inset-0 z-50 bg-slate-950/70 backdrop-blur-md hidden flex items-center justify-center p-4">
    <div class="glass-panel bg-white w-full max-w-md rounded-3xl p-6 sm:p-8 shadow-2xl border border-slate-200">
      
      <div class="flex justify-between items-start mb-6">
        <div>
          <div class="flex items-center gap-2 mb-1">
            <span class="px-2 py-0.5 rounded-full bg-emerald-100 text-emerald-800 text-[10px] font-bold">Paystack Secured</span>
            <span class="text-[10px] text-slate-400">Card / USSD / NIP</span>
          </div>
          <h3 class="text-xl font-bold text-wmcNavy-950">Fund Co-op Account Online</h3>
        </div>
        <button onclick="closePaystackOnlinePaymentModal()" class="text-slate-400 hover:text-slate-700 text-lg font-bold">✕</button>
      </div>

      <form id="paystack-payment-form" onsubmit="handlePaystackPaymentSubmit(event)" class="space-y-4 text-xs">
        <div>
          <label class="block font-bold text-slate-700 mb-1">Payment Purpose *</label>
          <select id="paystack-pay-purpose" class="w-full p-2.5 rounded-lg border border-slate-300 bg-white font-semibold">
            <option value="MONTHLY_PAYMENT_ADVICE">Monthly Payment Advice Settlement (Waterfall Auto-Split)</option>
            <option value="SAVINGS">Regular Co-op Savings Top-Up</option>
            <option value="MONTHLY_CONTRIBUTION">Monthly Mandatory Remittance (Tripartite Split)</option>
            <option value="SHARE_CAPITAL">Additional Share Capital Units</option>
            <option value="LOAN_REPAYMENT">Loan Capital / Administrative Fee Repayment</option>
          </select>
        </div>

        <div>
          <label class="block font-bold text-slate-700 mb-1">Amount to Pay (NGN) *</label>
          <div class="relative">
            <span class="absolute left-3 top-2.5 font-bold text-slate-500">₦</span>
            <input type="number" id="paystack-pay-amount" required min="1000" step="500" value="10000" class="w-full pl-8 p-2.5 rounded-lg border border-slate-300 font-bold text-sm">
          </div>
          <span class="text-[10px] text-slate-400 mt-1 block">Minimum online payment: ₦1,000</span>
        </div>

        <div class="p-4 bg-slate-50 rounded-2xl border border-slate-200 text-slate-600 space-y-1.5 text-[11px]">
          <div class="flex justify-between font-bold text-slate-800">
            <span>Payment Gateway:</span>
            <span class="text-emerald-600 font-mono">Paystack Nigeria</span>
          </div>
          <div class="flex justify-between">
            <span>Settlement:</span>
            <span>Real-time Automated Ledger Posting</span>
          </div>
          <div class="flex justify-between">
            <span>Supported Channels:</span>
            <span>Debit Card, Bank Transfer, USSD</span>
          </div>
        </div>

        <div id="paystack-pay-status" class="hidden p-3 rounded-xl text-xs font-semibold"></div>

        <div class="pt-2 flex items-center gap-3">
          <button type="button" onclick="closePaystackOnlinePaymentModal()" class="flex-1 py-3 rounded-xl border border-slate-300 hover:bg-slate-100 text-slate-700 font-bold transition">
            Cancel
          </button>
          <button type="submit" id="btn-paystack-submit" class="flex-2 py-3 rounded-xl bg-gradient-to-r from-emerald-600 to-teal-700 hover:from-emerald-500 hover:to-teal-600 text-white font-black text-xs shadow-lg transition flex items-center justify-center gap-2">
            <span>🔒</span>
            <span>Proceed to Paystack &rarr;</span>
          </button>
        </div>
      </form>
    </div>
  </div>

