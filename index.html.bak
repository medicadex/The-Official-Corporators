                <span class="text-slate-400 text-[10px]">Strict Non-Interest Financing Invariant</span>
              </div>
            </div>

            <!-- Presidential Approval for Statutory Contact Modifications -->
            <div class="pt-6 border-t border-slate-200">
              <div class="flex justify-between items-center mb-3">
