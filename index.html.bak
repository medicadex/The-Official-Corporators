            </button>
            <button id="btn-view-reports" onclick="switchPortalView('reports')" class="px-3 py-1.5 rounded-lg text-xs font-bold text-slate-500 hover:text-wmcNavy-950 transition flex items-center gap-1">
              <span>📑 Statements &amp; Reports</span>
            </button>
