<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Wealthbridge Multipurpose Cooperative Society Limited | WMC</title>
  
  <!-- Tailwind CSS CDN -->
  <script src="https://cdn.tailwindcss.com"></script>
  <script>
    tailwind.config = {
      theme: {
        extend: {
          colors: {
            wmcNavy: {
              950: '#071224',
              900: '#0b1a30',
              800: '#102544',
              700: '#1a365d',
            },
            wmcGold: {
              DEFAULT: '#d97706',
              light: '#f59e0b',
              dark: '#b45309',
            },
            wmcEmerald: {
              DEFAULT: '#10b981',
              light: '#34d399',
              dark: '#059669',
            },
            wmcPurple: {
              DEFAULT: '#8b5cf6',
              light: '#a78bfa',
              dark: '#7c3aed',
            }
          }
        }
      }
    }
  </script>

  <!-- Google Fonts & Custom CSS -->
  <link rel="stylesheet" href="styles.css">
</head>
<body class="bg-slate-50 text-slate-800 antialiased min-h-screen flex flex-col">

  <!-- =========================================================================
       1. TOP STATUTORY & UTILITY BAR (Vizient Style)
       ========================================================================= -->
  <div class="top-utility-bar py-2 px-4 sm:px-8 border-b border-slate-800">
    <div class="max-w-7xl mx-auto flex flex-col sm:flex-row items-center justify-between gap-2 text-xs">
      <div class="flex items-center gap-4 text-slate-300">
        <span class="flex items-center gap-1.5">
          <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
          <span>Lagos State Cooperative Societies Law (Cap C15)</span>
        </span>
        <span class="hidden md:inline text-slate-500">|</span>
        <span class="hidden md:flex items-center gap-1.5">
          ✉️ <a href="mailto:wealthbridge.coopsociety@gmail.com" class="hover:text-amber-400 transition">wealthbridge.coopsociety@gmail.com</a>
        </span>
      </div>

      <div class="flex items-center gap-4">
        <span class="hidden sm:inline text-slate-400">Secretariat: 13, Agbaje Iloro Street, Odogunyan, Ikorodu</span>
        <span class="text-slate-500">|</span>
        <button onclick="togglePortalMode()" class="text-amber-400 font-semibold hover:underline flex items-center gap-1">
          🔐 <span id="portal-toggle-label">Member Portal</span>
        </button>
      </div>
    </div>
  </div>

  <!-- =========================================================================
       MODAL: ADMIN ENROLL NEW COOPERATOR
       ========================================================================= -->
  <div id="modal-admin-add-member" class="fixed inset-0 z-50 bg-slate-950/70 backdrop-blur-md hidden flex items-center justify-center p-4 overflow-y-auto">
    <div class="glass-panel p-6 sm:p-8 rounded-3xl max-w-2xl w-full border border-slate-200 shadow-2xl my-8 max-h-[90vh] overflow-y-auto">
      <div class="flex justify-between items-center pb-4 border-b border-slate-200">
        <div>
          <span class="text-[10px] font-bold text-amber-600 uppercase tracking-wider block">Administrative Onboarding</span>
          <h3 class="font-serif-title text-xl font-bold text-wmcNavy-950">Enroll New Cooperator</h3>
        </div>
        <button onclick="closeAdminAddMemberModal()" class="text-slate-400 hover:text-slate-600 text-2xl font-bold leading-none">&times;</button>
      </div>

      <div class="p-3 my-4 rounded-xl bg-amber-50 border border-amber-200 text-amber-900 text-xs">
        💡 <strong>Initial Credentials:</strong> The member will be assigned the next sequential Member Code (e.g. <code>WMC-2026-xxx</code>) and the official initial password <code class="font-bold text-amber-950 bg-amber-200/70 px-1 rounded">Wealthbridge@2026</code>.
      </div>

      <form id="form-admin-add-member" onsubmit="handleAdminAddMemberSubmit(event)" class="space-y-5 text-xs">
        
        <!-- Section 1: Names & Basic Biodata -->
        <div>
          <h4 class="font-bold text-slate-800 uppercase tracking-wider text-[11px] mb-3 pb-1 border-b border-slate-100 flex items-center gap-1.5">
            <span>👤 1. Cooperator Biodata</span>
          </h4>
          <div class="grid grid-cols-1 sm:grid-cols-3 gap-3">
            <div>
              <label class="block font-bold text-slate-700 mb-1">First Name *</label>
              <input type="text" id="admin-add-first-name" required placeholder="e.g. Adebayo" class="w-full p-2.5 rounded-lg border border-slate-300">
            </div>
            <div>
              <label class="block font-bold text-slate-700 mb-1">Last Name *</label>
              <input type="text" id="admin-add-last-name" required placeholder="e.g. Ogunlesi" class="w-full p-2.5 rounded-lg border border-slate-300">
            </div>
            <div>
              <label class="block font-bold text-slate-700 mb-1">Middle / Other Names</label>
              <input type="text" id="admin-add-other-names" placeholder="e.g. Babatunde" class="w-full p-2.5 rounded-lg border border-slate-300">
            </div>
          </div>
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 mt-3">
            <div>
              <label class="block font-bold text-slate-700 mb-1">Gender *</label>
              <select id="admin-add-gender" required class="w-full p-2.5 rounded-lg border border-slate-300">
                <option value="MALE">Male</option>
                <option value="FEMALE">Female</option>
              </select>
            </div>
            <div>
              <label class="block font-bold text-slate-700 mb-1">Marital Status *</label>
              <select id="admin-add-marital-status" required class="w-full p-2.5 rounded-lg border border-slate-300">
                <option value="MARRIED">Married</option>
                <option value="SINGLE">Single</option>
                <option value="DIVORCED">Divorced</option>
                <option value="WIDOWED">Widowed</option>
              </select>
            </div>
          </div>
        </div>

        <!-- Section 2: Contact Details -->
        <div>
          <h4 class="font-bold text-slate-800 uppercase tracking-wider text-[11px] mb-3 pb-1 border-b border-slate-100 flex items-center gap-1.5">
            <span>📍 2. Contact &amp; Residential Details</span>
          </h4>
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
            <div>
              <label class="block font-bold text-slate-700 mb-1">Official / Personal Email *</label>
              <input type="email" id="admin-add-email" required placeholder="member@example.com" class="w-full p-2.5 rounded-lg border border-slate-300">
            </div>
            <div>
              <label class="block font-bold text-slate-700 mb-1">WhatsApp / Phone Number *</label>
              <input type="tel" id="admin-add-phone" required placeholder="08012345678" class="w-full p-2.5 rounded-lg border border-slate-300">
            </div>
          </div>
          <div class="mt-3">
            <label class="block font-bold text-slate-700 mb-1">Residential Address (Lagos State) *</label>
            <textarea id="admin-add-address" required rows="2" placeholder="Full residential street address in Lagos State..." class="w-full p-2.5 rounded-lg border border-slate-300"></textarea>
          </div>
        </div>

        <!-- Section 3: Professional & Standing -->
        <div>
          <h4 class="font-bold text-slate-800 uppercase tracking-wider text-[11px] mb-3 pb-1 border-b border-slate-100 flex items-center gap-1.5">
            <span>💼 3. Professional &amp; Cooperative Standing</span>
          </h4>
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
            <div>
              <label class="block font-bold text-slate-700 mb-1">Employment Status *</label>
              <select id="admin-add-emp-status" required class="w-full p-2.5 rounded-lg border border-slate-300">
                <option value="SALARY_EARNER">Salary Earner (Corporate / Public)</option>
                <option value="BUSINESS_OWNER">Business Owner / Entrepreneur</option>
                <option value="SELF_EMPLOYED">Self-Employed Professional</option>
              </select>
            </div>
            <div>
              <label class="block font-bold text-slate-700 mb-1">Employer / Business Name</label>
              <input type="text" id="admin-add-employer" placeholder="Company or Enterprise Name" class="w-full p-2.5 rounded-lg border border-slate-300">
            </div>
          </div>
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 mt-3">
            <div>
              <label class="block font-bold text-slate-700 mb-1">Monthly Contribution Tier *</label>
              <select id="admin-add-tier" required class="w-full p-2.5 rounded-lg border border-slate-300 font-bold text-wmcNavy-950">
                <option value="STANDARD">Standard Tier (₦10,000 / month)</option>
                <option value="PLUS">Plus Tier (₦50,000 / month)</option>
                <option value="PREMIUM">Premium Tier (₦100,000 / month)</option>
              </select>
            </div>
            <div>
              <label class="block font-bold text-slate-700 mb-1">Initial Membership Status *</label>
              <select id="admin-add-status" required class="w-full p-2.5 rounded-lg border border-slate-300">
                <option value="ACTIVE">ACTIVE (Fully Approved)</option>
                <option value="PENDING_KYC">PENDING KYC (Awaiting Docs)</option>
              </select>
            </div>
          </div>
        </div>

        <!-- Section 4: National Identification & Banking -->
        <div>
          <h4 class="font-bold text-slate-800 uppercase tracking-wider text-[11px] mb-3 pb-1 border-b border-slate-100 flex items-center gap-1.5">
            <span>🏦 4. NIN &amp; Commercial Bank Disbursement Details</span>
          </h4>
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
            <div>
              <label class="block font-bold text-slate-700 mb-1">Identification Type</label>
              <select id="admin-add-id-type" class="w-full p-2.5 rounded-lg border border-slate-300">
                <option value="NIN">National Identity Number (NIN)</option>
                <option value="INTL_PASSPORT">International Passport</option>
                <option value="DRIVERS_LICENSE">Driver's License</option>
              </select>
            </div>
            <div>
              <label class="block font-bold text-slate-700 mb-1">NIN / ID Number</label>
              <input type="text" id="admin-add-id-number" placeholder="11-digit NIN" class="w-full p-2.5 rounded-lg border border-slate-300 font-mono">
            </div>
          </div>
          <div class="grid grid-cols-1 sm:grid-cols-3 gap-3 mt-3">
            <div>
              <label class="block font-bold text-slate-700 mb-1">Bank Name</label>
              <input type="text" id="admin-add-bank-name" placeholder="e.g. Polaris Bank" class="w-full p-2.5 rounded-lg border border-slate-300">
            </div>
            <div>
              <label class="block font-bold text-slate-700 mb-1">Account Number</label>
              <input type="text" id="admin-add-bank-acc-num" placeholder="10-digit NUBAN" class="w-full p-2.5 rounded-lg border border-slate-300 font-mono">
            </div>
            <div>
              <label class="block font-bold text-slate-700 mb-1">Account Name</label>
              <input type="text" id="admin-add-bank-acc-name" placeholder="Name on account" class="w-full p-2.5 rounded-lg border border-slate-300">
            </div>
          </div>
        </div>

        <!-- Section 5: Next of Kin -->
        <div>
          <h4 class="font-bold text-slate-800 uppercase tracking-wider text-[11px] mb-3 pb-1 border-b border-slate-100 flex items-center gap-1.5">
            <span>🛡️ 5. Next of Kin (Statutory Solidarity Beneficiary)</span>
          </h4>
          <div class="grid grid-cols-1 sm:grid-cols-3 gap-3">
            <div>
              <label class="block font-bold text-slate-700 mb-1">Next of Kin Name</label>
              <input type="text" id="admin-add-nok-name" placeholder="Full legal name" class="w-full p-2.5 rounded-lg border border-slate-300">
            </div>
            <div>
              <label class="block font-bold text-slate-700 mb-1">Relationship</label>
              <input type="text" id="admin-add-nok-rel" placeholder="e.g. Spouse / Sibling" class="w-full p-2.5 rounded-lg border border-slate-300">
            </div>
            <div>
              <label class="block font-bold text-slate-700 mb-1">Next of Kin Phone</label>
              <input type="tel" id="admin-add-nok-phone" placeholder="080..." class="w-full p-2.5 rounded-lg border border-slate-300">
            </div>
          </div>
        </div>

        <div class="pt-4 border-t border-slate-200 flex items-center justify-end gap-3">
          <button type="button" onclick="closeAdminAddMemberModal()" class="px-5 py-2.5 rounded-xl border border-slate-300 hover:bg-slate-100 text-slate-700 font-bold transition">
            Cancel
          </button>
          <button type="submit" id="btn-admin-add-submit" class="px-6 py-2.5 rounded-xl bg-wmcNavy-950 hover:bg-slate-900 text-amber-400 font-extrabold shadow-md transition flex items-center gap-2">
            <span>Enroll Cooperator &rarr;</span>
          </button>
        </div>

      </form>
    </div>
  </div>

  <!-- =========================================================================
       MODAL: ADMIN MODIFY MEMBER BIODATA
       ========================================================================= -->
  <div id="modal-admin-edit-member" class="fixed inset-0 z-50 bg-slate-950/70 backdrop-blur-md hidden flex items-center justify-center p-4 overflow-y-auto">
    <div class="glass-panel p-6 sm:p-8 rounded-3xl max-w-2xl w-full border border-slate-200 shadow-2xl my-8 max-h-[90vh] overflow-y-auto">
      <div class="flex justify-between items-center pb-4 border-b border-slate-200">
        <div>
          <span class="text-[10px] font-bold text-amber-600 uppercase tracking-wider block">Administrative Modification</span>
          <h3 class="font-serif-title text-xl font-bold text-wmcNavy-950">Modify Cooperator Biodata</h3>
        </div>
        <button onclick="closeAdminEditMemberModal()" class="text-slate-400 hover:text-slate-600 text-2xl font-bold leading-none">&times;</button>
      </div>

      <div class="flex items-center justify-between p-3 my-4 rounded-xl bg-slate-100 border border-slate-200 text-xs">
        <div>
          <span class="text-slate-500">Target Member:</span>
          <strong id="admin-edit-display-name" class="text-wmcNavy-950 ml-1">---</strong>
        </div>
        <span id="admin-edit-display-code" class="px-2.5 py-0.5 rounded font-mono font-bold bg-wmcNavy-950 text-amber-300 text-xs">WMC-2026-xxx</span>
      </div>

      <form id="form-admin-edit-member" onsubmit="handleAdminEditMemberSubmit(event)" class="space-y-5 text-xs">
        <input type="hidden" id="admin-edit-member-id">

        <!-- Section 1: Names & Basic Biodata -->
        <div>
          <h4 class="font-bold text-slate-800 uppercase tracking-wider text-[11px] mb-3 pb-1 border-b border-slate-100 flex items-center gap-1.5">
            <span>👤 1. Cooperator Biodata</span>
          </h4>
          <div class="grid grid-cols-1 sm:grid-cols-3 gap-3">
            <div>
              <label class="block font-bold text-slate-700 mb-1">First Name *</label>
              <input type="text" id="admin-edit-first-name" required class="w-full p-2.5 rounded-lg border border-slate-300">
            </div>
            <div>
              <label class="block font-bold text-slate-700 mb-1">Last Name *</label>
              <input type="text" id="admin-edit-last-name" required class="w-full p-2.5 rounded-lg border border-slate-300">
            </div>
            <div>
              <label class="block font-bold text-slate-700 mb-1">Middle / Other Names</label>
              <input type="text" id="admin-edit-other-names" class="w-full p-2.5 rounded-lg border border-slate-300">
            </div>
          </div>
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 mt-3">
            <div>
              <label class="block font-bold text-slate-700 mb-1">Gender *</label>
              <select id="admin-edit-gender" required class="w-full p-2.5 rounded-lg border border-slate-300">
                <option value="MALE">Male</option>
                <option value="FEMALE">Female</option>
              </select>
            </div>
            <div>
              <label class="block font-bold text-slate-700 mb-1">Marital Status *</label>
              <select id="admin-edit-marital-status" required class="w-full p-2.5 rounded-lg border border-slate-300">
                <option value="MARRIED">Married</option>
                <option value="SINGLE">Single</option>
                <option value="DIVORCED">Divorced</option>
                <option value="WIDOWED">Widowed</option>
              </select>
            </div>
          </div>
        </div>

        <!-- Section 2: Contact Details -->
        <div>
          <h4 class="font-bold text-slate-800 uppercase tracking-wider text-[11px] mb-3 pb-1 border-b border-slate-100 flex items-center gap-1.5">
            <span>📍 2. Contact &amp; Residential Details</span>
          </h4>
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
            <div>
              <label class="block font-bold text-slate-700 mb-1">Official / Personal Email *</label>
              <input type="email" id="admin-edit-email" required class="w-full p-2.5 rounded-lg border border-slate-300">
            </div>
            <div>
              <label class="block font-bold text-slate-700 mb-1">WhatsApp / Phone Number *</label>
              <input type="tel" id="admin-edit-phone" required class="w-full p-2.5 rounded-lg border border-slate-300">
            </div>
          </div>
          <div class="mt-3">
            <label class="block font-bold text-slate-700 mb-1">Residential Address (Lagos State) *</label>
            <textarea id="admin-edit-address" required rows="2" class="w-full p-2.5 rounded-lg border border-slate-300"></textarea>
          </div>
        </div>

        <!-- Section 3: Professional & Standing -->
        <div>
          <h4 class="font-bold text-slate-800 uppercase tracking-wider text-[11px] mb-3 pb-1 border-b border-slate-100 flex items-center gap-1.5">
            <span>💼 3. Professional &amp; Cooperative Standing</span>
          </h4>
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
            <div>
              <label class="block font-bold text-slate-700 mb-1">Employment Status *</label>
              <select id="admin-edit-emp-status" required class="w-full p-2.5 rounded-lg border border-slate-300">
                <option value="SALARY_EARNER">Salary Earner (Corporate / Public)</option>
                <option value="BUSINESS_OWNER">Business Owner / Entrepreneur</option>
                <option value="SELF_EMPLOYED">Self-Employed Professional</option>
              </select>
            </div>
            <div>
              <label class="block font-bold text-slate-700 mb-1">Employer / Business Name</label>
              <input type="text" id="admin-edit-employer" class="w-full p-2.5 rounded-lg border border-slate-300">
            </div>
          </div>
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 mt-3">
            <div>
              <label class="block font-bold text-slate-700 mb-1">Monthly Contribution Tier *</label>
              <select id="admin-edit-tier" required class="w-full p-2.5 rounded-lg border border-slate-300 font-bold text-wmcNavy-950">
                <option value="STANDARD">Standard Tier (₦10,000 / month)</option>
                <option value="PLUS">Plus Tier (₦50,000 / month)</option>
                <option value="PREMIUM">Premium Tier (₦100,000 / month)</option>
              </select>
            </div>
            <div>
              <label class="block font-bold text-slate-700 mb-1">Membership Standing Status *</label>
              <select id="admin-edit-status" required class="w-full p-2.5 rounded-lg border border-slate-300 font-bold">
                <option value="ACTIVE">ACTIVE (In Good Standing)</option>
                <option value="PENDING_KYC">PENDING KYC (Under Review)</option>
                <option value="SUSPENDED">SUSPENDED (Disciplinary Hold)</option>
                <option value="EXPELLED">EXPELLED (Membership Revoked)</option>
                <option value="DECEASED">DECEASED (Estate Settlement)</option>
              </select>
            </div>
          </div>
        </div>

        <!-- Section 4: National Identification & Banking -->
        <div>
          <h4 class="font-bold text-slate-800 uppercase tracking-wider text-[11px] mb-3 pb-1 border-b border-slate-100 flex items-center gap-1.5">
            <span>🏦 4. NIN &amp; Commercial Bank Disbursement Details</span>
          </h4>
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
            <div>
              <label class="block font-bold text-slate-700 mb-1">Identification Type</label>
              <select id="admin-edit-id-type" class="w-full p-2.5 rounded-lg border border-slate-300">
                <option value="NIN">National Identity Number (NIN)</option>
                <option value="INTL_PASSPORT">International Passport</option>
                <option value="DRIVERS_LICENSE">Driver's License</option>
              </select>
            </div>
            <div>
              <label class="block font-bold text-slate-700 mb-1">NIN / ID Number</label>
              <input type="text" id="admin-edit-id-number" class="w-full p-2.5 rounded-lg border border-slate-300 font-mono">
            </div>
          </div>
          <div class="grid grid-cols-1 sm:grid-cols-4 gap-3 mt-3">
            <div>
              <label class="block font-bold text-slate-700 mb-1">Bank Name</label>
              <input type="text" id="admin-edit-bank-name" class="w-full p-2.5 rounded-lg border border-slate-300">
            </div>
            <div>
              <label class="block font-bold text-slate-700 mb-1">Account Number</label>
              <input type="text" id="admin-edit-bank-acc-num" class="w-full p-2.5 rounded-lg border border-slate-300 font-mono">
            </div>
            <div>
              <label class="block font-bold text-slate-700 mb-1">Account Name</label>
              <input type="text" id="admin-edit-bank-acc-name" class="w-full p-2.5 rounded-lg border border-slate-300">
            </div>
            <div>
              <label class="block font-bold text-slate-700 mb-1">BVN</label>
              <input type="text" id="admin-edit-bvn" class="w-full p-2.5 rounded-lg border border-slate-300 font-mono">
            </div>
          </div>
        </div>

        <!-- Section 5: Next of Kin -->
        <div>
          <h4 class="font-bold text-slate-800 uppercase tracking-wider text-[11px] mb-3 pb-1 border-b border-slate-100 flex items-center gap-1.5">
            <span>🛡️ 5. Next of Kin (Statutory Solidarity Beneficiary)</span>
          </h4>
          <div class="grid grid-cols-1 sm:grid-cols-3 gap-3">
            <div>
              <label class="block font-bold text-slate-700 mb-1">Next of Kin Name</label>
              <input type="text" id="admin-edit-nok-name" class="w-full p-2.5 rounded-lg border border-slate-300">
            </div>
            <div>
              <label class="block font-bold text-slate-700 mb-1">Relationship</label>
              <input type="text" id="admin-edit-nok-rel" class="w-full p-2.5 rounded-lg border border-slate-300">
            </div>
            <div>
              <label class="block font-bold text-slate-700 mb-1">Next of Kin Phone</label>
              <input type="tel" id="admin-edit-nok-phone" class="w-full p-2.5 rounded-lg border border-slate-300">
            </div>
          </div>
        </div>

        <div class="pt-4 border-t border-slate-200 flex items-center justify-end gap-3">
          <button type="button" onclick="closeAdminEditMemberModal()" class="px-5 py-2.5 rounded-xl border border-slate-300 hover:bg-slate-100 text-slate-700 font-bold transition">
            Cancel
          </button>
          <button type="submit" id="btn-admin-edit-submit" class="px-6 py-2.5 rounded-xl bg-amber-600 hover:bg-amber-700 text-white font-extrabold shadow-md transition flex items-center gap-2">
            <span>Save Biodata Modifications &rarr;</span>
          </button>
        </div>

      </form>
    </div>
  </div>

  <!-- =========================================================================
       MODAL: ADMIN RESET MEMBER PASSWORD TO DEFAULT
       ========================================================================= -->
