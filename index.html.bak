            Start Here
          </button>
        </div>

        <!-- Authenticated State (Shown when logged in) -->
        <div id="nav-auth-actions" class="hidden flex items-center gap-3">
          <div class="flex items-center gap-2.5 bg-slate-100 hover:bg-slate-200/70 border border-slate-200 py-1.5 px-3 rounded-xl cursor-pointer" onclick="togglePortalMode()">
            <div id="nav-user-avatar" class="w-7 h-7 rounded-lg bg-gradient-to-br from-wmcNavy-950 to-wmcNavy-800 text-amber-300 flex items-center justify-center font-extrabold text-[11px] border border-amber-400/30">
              QA
            </div>
            <div class="text-left hidden sm:block">
              <span id="nav-user-name" class="block font-bold text-xs text-wmcNavy-950 leading-tight">Qazeem Adebowale</span>
              <span id="nav-user-role-badge" class="inline-block text-[9px] font-black uppercase tracking-wider text-amber-700 bg-amber-100 px-1.5 py-0.5 rounded">PRESIDENT</span>
            </div>
          </div>

          <button onclick="openProfileModal()" class="px-3 py-2 text-xs font-bold rounded-lg bg-amber-500 hover:bg-amber-600 text-white transition shadow-sm inline-flex items-center gap-1.5" title="View & Update Profile and KYC">
            <span>👤</span>
            <span id="nav-kyc-label">KYC Profile</span>
          </button>

          <button id="nav-portal-btn" onclick="togglePortalMode()" class="px-3 py-2 text-xs font-bold rounded-lg bg-wmcNavy-900 text-white hover:bg-wmcNavy-800 transition shadow-sm hidden sm:inline-flex items-center gap-1.5">
            <span>📊</span>
            <span id="nav-portal-btn-label">Dashboard</span>
          </button>

          <button onclick="handleLogout()" title="Sign Out" class="p-2 text-slate-400 hover:text-red-600 rounded-lg border border-slate-200 hover:border-red-200 hover:bg-red-50 transition text-xs font-bold flex items-center gap-1">
            <span>🚪</span>
            <span class="hidden md:inline">Sign Out</span>
          </button>
        </div>
      </div>

    </div>
  </header>

  <!-- =========================================================================
       MAIN CONTENT CONTAINER (PUBLIC LANDING OR MEMBER PORTAL)
       ========================================================================= -->
  <main id="main-content" class="flex-1">

    <!-- +++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
         VIEW 1: PUBLIC SHOWCASE (VIZIENT COOP MODEL)
         +++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++ -->
    <div id="public-landing-view">

      <!-- HERO SECTION -->
      <section id="home" class="vizient-hero py-16 sm:py-24 border-b border-slate-200">
        <div class="max-w-7xl mx-auto px-4 sm:px-8">
          <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-center">
            
            <!-- Left Headline Stack -->
            <div class="lg:col-span-7">
              <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-emerald-50 border border-emerald-200 text-emerald-800 text-xs font-semibold mb-6">
                <span class="w-2 h-2 rounded-full bg-emerald-500"></span>
                <span>The Sovereign Middle-Class Wealth Platform</span>
              </div>
              
              <h1 class="font-serif-title text-4xl sm:text-5xl lg:text-6xl font-extrabold text-wmcNavy-950 tracking-tight leading-[1.15] mb-6">
