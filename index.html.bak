      <!-- =====================================================================
           INTERACTIVE SAVINGS & 2X LOAN CALCULATOR
           ===================================================================== -->
      <section id="calculator" class="py-20 bg-slate-50 border-b border-slate-200">
        <div class="max-w-5xl mx-auto px-4 sm:px-8">
          <div class="text-center mb-12">
            <h2 class="font-serif-title text-3xl sm:text-4xl font-extrabold text-wmcNavy-950 mb-3">
              Interactive Borrowing &amp; Savings Estimator
            </h2>
            <p class="text-slate-600 text-sm">
              Model your prospective wealth growth, share equity accumulation, and 2× loan qualification over time.
            </p>
          </div>

          <div class="glass-panel p-8 sm:p-10 rounded-3xl border border-slate-200 shadow-xl grid grid-cols-1 md:grid-cols-12 gap-8 items-center">
            
            <!-- Controls (Left 6 Cols) -->
            <div class="md:col-span-6 space-y-6">
              
              <!-- Slider 1: Monthly Contribution -->
              <div>
                <div class="flex justify-between items-center mb-2">
                  <label class="text-xs font-bold text-slate-700 uppercase">Monthly Contribution</label>
                  <span id="slider-contrib-display" class="text-base font-extrabold text-wmcNavy-950">₦10,000</span>
                </div>
                <input id="slider-contrib" type="range" min="10000" max="100000" step="5000" value="10000" oninput="updateCalculator()" class="w-full h-2 bg-slate-200 rounded-lg cursor-pointer">
                <div class="flex justify-between text-[11px] text-slate-400 mt-1">
                  <span>₦10,000 (Standard)</span>
                  <span>₦50,000</span>
                  <span>₦100,000 (Premium)</span>
                </div>
              </div>

              <!-- Slider 2: Membership Duration -->
              <div>
                <div class="flex justify-between items-center mb-2">
                  <label class="text-xs font-bold text-slate-700 uppercase">Membership Duration</label>
                  <span id="slider-months-display" class="text-base font-extrabold text-wmcNavy-950">6 Months</span>
                </div>
                <input id="slider-months" type="range" min="3" max="24" step="1" value="6" oninput="updateCalculator()" class="w-full h-2 bg-slate-200 rounded-lg cursor-pointer">
                <div class="flex justify-between text-[11px] text-slate-400 mt-1">
                  <span>3 Months</span>
                  <span>6 Months (Loan Qualified)</span>
                  <span>24 Months</span>
                </div>
              </div>

              <!-- Rule Callout -->
              <div class="p-4 rounded-xl bg-amber-50 border border-amber-200 text-amber-900 text-xs space-y-1">
                <span class="font-bold block">The 6-Month Qualification Benchmark:</span>
                <p class="text-amber-800 leading-relaxed">
                  Borrowing rights activate after 6 consecutive months of remittances and minimum 5 paid-up share units (₦5,000). Compounding interest is strictly 0.0%.
                </p>
              </div>

            </div>

            <!-- Live Output Card (Right 6 Cols) -->
            <div class="md:col-span-6 bg-wmcNavy-950 text-white p-7 sm:p-8 rounded-2xl shadow-inner space-y-5">
              
              <div class="border-b border-slate-800 pb-4">
                <span class="text-xs font-semibold text-slate-400 block mb-1">Total Liquid Savings Accumulated:</span>
                <span id="calc-savings" class="text-3xl font-extrabold text-white">₦48,000</span>
                <span class="text-[11px] text-slate-400 block mt-1">Primary 100% Cash Collateral</span>
              </div>

              <div class="border-b border-slate-800 pb-4">
                <span class="text-xs font-semibold text-amber-400 block mb-1">Allowable 2× Loan Borrowing Power:</span>
                <span id="calc-loan" class="text-3xl font-extrabold text-amber-400">₦96,000</span>
                <span class="text-[11px] text-slate-400 block mt-1">0% Compounding Interest (Flat admin cost recovery)</span>
              </div>

              <div class="grid grid-cols-2 gap-4 text-xs pt-1">
                <div>
                  <span class="text-slate-400 block">Paid-Up Shares:</span>
                  <span id="calc-shares" class="font-bold text-emerald-400 text-sm">6 units (₦6,000)</span>
                </div>
                <div>
                  <span class="text-slate-400 block">Welfare Solidarity:</span>
                  <span id="calc-welfare" class="font-bold text-purple-400 text-sm">₦6,000 Pool</span>
                </div>
              </div>

              <button onclick="openRegistrationModal()" class="w-full mt-4 py-3 rounded-xl btn-accent text-xs font-bold shadow-lg">
                Lock in This Plan &rarr;
              </button>

            </div>

          </div>
        </div>
      </section>

    </div>

    <!-- +++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
