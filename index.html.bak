      <!-- =====================================================================
           METRICS & SOCIAL PROOF RIBBON (Vizient Style)
           ===================================================================== -->
      <section class="py-10 bg-white border-b border-slate-200">
        <div class="max-w-7xl mx-auto px-4 sm:px-8">
          <div class="grid grid-cols-2 lg:grid-cols-4 gap-8">
            
            <div class="p-4 border-l-2 border-amber-500">
              <span class="block text-3xl sm:text-4xl font-extrabold text-wmcNavy-950 mb-1">₦1.0M</span>
              <span class="text-xs font-semibold text-slate-500 uppercase tracking-wider">Target Capital Engine</span>
              <p class="text-xs text-slate-400 mt-1">Foundational share pool powering the CO-CARE marketplace</p>
            </div>

            <div class="p-4 border-l-2 border-emerald-500">
              <span class="block text-3xl sm:text-4xl font-extrabold text-emerald-600 mb-1">0%</span>
              <span class="text-xs font-semibold text-slate-500 uppercase tracking-wider">Compounding Interest</span>
              <p class="text-xs text-slate-400 mt-1">Strict non-interest model with flat administrative cost-recovery</p>
            </div>

            <div class="p-4 border-l-2 border-blue-500">
              <span class="block text-3xl sm:text-4xl font-extrabold text-wmcNavy-950 mb-1">2.0×</span>
              <span class="text-xs font-semibold text-slate-500 uppercase tracking-wider">Savings Loan Baseline</span>
              <p class="text-xs text-slate-400 mt-1">Double your unencumbered savings for personal &amp; asset financing</p>
            </div>

            <div class="p-4 border-l-2 border-purple-500">
              <span class="block text-3xl sm:text-4xl font-extrabold text-wmcNavy-950 mb-1">₦1,000</span>
              <span class="text-xs font-semibold text-slate-500 uppercase tracking-wider">Monthly Welfare Pool</span>
              <p class="text-xs text-slate-400 mt-1">Guaranteed solidarity grants for bereavement, medicals, &amp; births</p>
            </div>

          </div>
        </div>
      </section>

      <!-- =====================================================================
           WHAT MAKES US DIFFERENT (4 Checkmark Cards - Vizient Style)
           ===================================================================== -->
      <section id="difference" class="py-20 bg-slate-50 border-b border-slate-200">
        <div class="max-w-7xl mx-auto px-4 sm:px-8">
          <div class="max-w-3xl mb-14">
            <h2 class="font-serif-title text-3xl sm:text-4xl font-extrabold text-wmcNavy-950 mb-4">
              What makes us different
            </h2>
            <p class="text-slate-600 text-sm sm:text-base leading-relaxed">
              We care about salary earners and working professionals, building an ironclad operating system for their lasting financial independence.
            </p>
          </div>

          <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
            
            <!-- Card 1 -->
            <div class="glass-panel p-7 rounded-2xl border border-slate-200 hover:shadow-lg transition">
              <div class="w-10 h-10 rounded-xl bg-emerald-50 text-emerald-600 flex items-center justify-center font-bold text-lg mb-4">
                ✓
              </div>
              <h3 class="text-lg font-bold text-wmcNavy-950 mb-2">Professionalism &amp; Family Integrity Rule</h3>
              <p class="text-sm text-slate-600 leading-relaxed">
                Personal relationships and emotions are completely detached from official Cooperative affairs. Executive committee members are strictly barred from evaluating credit applications of family relations.
              </p>
            </div>

            <!-- Card 2 -->
            <div class="glass-panel p-7 rounded-2xl border border-slate-200 hover:shadow-lg transition">
              <div class="w-10 h-10 rounded-xl bg-amber-50 text-amber-600 flex items-center justify-center font-bold text-lg mb-4">
                ✓
              </div>
              <h3 class="text-lg font-bold text-wmcNavy-950 mb-2">Tripartite Ledger Accounting Mechanics</h3>
              <p class="text-sm text-slate-600 leading-relaxed">
                Every monthly remittance is segregated automatically into three statutory accounts: Regular Savings (liquid cash collateral), Share Capital (permanent equity), and Member Welfare Pool (mutual aid).
              </p>
            </div>

            <!-- Card 3 -->
            <div class="glass-panel p-7 rounded-2xl border border-slate-200 hover:shadow-lg transition">
              <div class="w-10 h-10 rounded-xl bg-blue-50 text-blue-600 flex items-center justify-center font-bold text-lg mb-4">
                ✓
              </div>
              <h3 class="text-lg font-bold text-wmcNavy-950 mb-2">Lagos State Statutory Registration &amp; Audit</h3>
              <p class="text-sm text-slate-600 leading-relaxed">
                Operating strictly under the Lagos State Cooperative Societies Law (Cap C15). Certified annual audits, registered Secretariat in Odogunyan, Ikorodu, and corporate banking with Polaris Bank Limited.
              </p>
            </div>

            <!-- Card 4 -->
            <div class="glass-panel p-7 rounded-2xl border border-slate-200 hover:shadow-lg transition">
              <div class="w-10 h-10 rounded-xl bg-purple-50 text-purple-600 flex items-center justify-center font-bold text-lg mb-4">
                ✓
              </div>
              <h3 class="text-lg font-bold text-wmcNavy-950 mb-2">CO-CARE Closed-Loop Member Marketplace</h3>
              <p class="text-sm text-slate-600 leading-relaxed">
                An internal economic exchange platform where verified member merchants trade directly. Cooperators can access zero-interest asset and equipment financing for bulk goods and tools.
              </p>
            </div>

          </div>
        </div>
      </section>

      <!-- =====================================================================
