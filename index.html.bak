          <strong id="reset-display-name" class="text-wmcNavy-950">---</strong>
        </div>
        <div class="flex justify-between">
          <span class="text-slate-500">Member Code:</span>
          <strong id="reset-display-code" class="font-mono text-amber-800">WMC-2026-xxx</strong>
        </div>
        <div class="flex justify-between pt-2 border-t border-slate-200">
          <span class="text-slate-500">New Password:</span>
          <code class="font-mono font-bold text-emerald-800 bg-emerald-100 px-2 py-0.5 rounded">Wealthbridge@2026</code>
        </div>
      </div>

      <div class="flex items-center gap-3">
        <button type="button" onclick="closeAdminResetPasswordModal()" class="flex-1 py-2.5 rounded-xl border border-slate-300 hover:bg-slate-100 text-slate-700 font-bold text-xs transition">
          Cancel
        </button>
        <button type="button" id="btn-admin-confirm-reset" onclick="confirmAdminResetPassword()" class="flex-1 py-2.5 rounded-xl bg-amber-600 hover:bg-amber-700 text-white font-black text-xs shadow-md transition flex items-center justify-center gap-1.5">
          <span>Confirm Reset</span>
