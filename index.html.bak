          W
        </div>
        <div>
          <span class="font-extrabold text-lg sm:text-xl tracking-tight text-wmcNavy-950 block leading-tight">WEALTHBRIDGE</span>
          <span class="text-[10px] tracking-wider uppercase text-slate-500 font-semibold block">Multipurpose Cooperative Society</span>
        </div>
