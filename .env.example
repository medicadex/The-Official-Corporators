# =====================================================================
# WEALTHBRIDGE MULTIPURPOSE COOPERATIVE SOCIETY LIMITED (WMC)
# ENVIRONMENT CONFIGURATION TEMPLATE (.env.example)
# Duplicate this file as .env and populate your actual secrets.
# =====================================================================

# --- LOCAL MYSQL DATABASE CONFIGURATION ---
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password_here
DB_NAME=wbmf
DB_SSL=false

# --- APPLICATION SECURITY ---
# Generate a long random value and keep it secret. Existing password hashes
# depend on this value, so do not rotate it without a controlled migration.
AUTH_SALT=replace_with_a_long_random_secret
SESSION_TTL_SECONDS=28800
MAX_LOGIN_ATTEMPTS=5
LOGIN_WINDOW_SECONDS=900
# Comma-separated browser origins permitted to call the API. Same-origin use is preferred.
CORS_ORIGINS=http://127.0.0.1:8088,http://localhost:8088

DATABASE_URL=mysql://root:your_mysql_password_here@127.0.0.1:3306/wbmf

# --- OFFICIAL PROJECT CONTACT & DETAILS ---
SOCIETY_NAME="Wealthbridge Multipurpose Cooperative Society Limited"
OFFICIAL_EMAIL=wealthbridge.coopsociety@gmail.com
REGISTERED_OFFICE="13, Agbaje Iloro Street, Odogunyan, Ikorodu, Lagos State, Nigeria"
BANK_PARTNER="Polaris Bank Limited"

# --- LEGACY / EXTERNAL CLOUD SERVICES (SUPABASE) ---
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key_here

# --- VERIFYME NG API (Bank & NUBAN Account Name Resolution) ---
# Get your API key from https://dashboard.verifyme.ng
VERIFYME_API_KEY=your_verifyme_api_key_here
VERIFYME_BASE_URL=https://vapi.verifyme.ng/v1
